DC-A568B connects its download key ladder to SARADC0.
Select SARADC0 through the root compatible. Keep SARADC1 for other machines.

diff --git a/arch/arm/mach-rockchip/boot_mode.c b/arch/arm/mach-rockchip/boot_mode.c
--- a/arch/arm/mach-rockchip/boot_mode.c
+++ b/arch/arm/mach-rockchip/boot_mode.c
@@ -40,7 +40,7 @@
 __weak int rockchip_dnl_key_pressed(void)
 {
 #if CONFIG_IS_ENABLED(ADC)
-	unsigned int val;
+	unsigned int val, channel = 1;
 	struct udevice *dev;
 	struct uclass *uc;
 	int ret;
@@ -49,10 +49,13 @@
 	if (ret)
 		return false;
 
+	if (of_machine_is_compatible("rockchip,dc-a568b"))
+		channel = 0;
+
 	ret = -ENODEV;
 	uclass_foreach_dev(dev, uc) {
 		if (!strncmp(dev->name, "saradc", 6)) {
-			ret = adc_channel_single_shot(dev->name, 1, &val);
+			ret = adc_channel_single_shot(dev->name, channel, &val);
 			break;
 		}
 	}
