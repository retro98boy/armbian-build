+static void select_fdtfile(void)
+{
+	phys_size_t ddr_size = (((readl(SYSCTRL_SEC_STATUS_REG4)) & ~0xffffUL) << 4);
+
+	switch (ddr_size) {
+	case 0x100000000:
+		env_set("fdtfile", "amlogic/amlogic-t7-a311d2-corelab-tvpro-4g.dtb");
+		break;
+	case 0x200000000:
+		env_set("fdtfile", "amlogic/amlogic-t7-a311d2-corelab-tvpro-8g.dtb");
+		break;
+	default:
+		printf("Unsupported TVPro memory size: %llu\n", (unsigned long long)ddr_size);
+		env_set("fdtfile", "unsupported.dtb");
+		break;
+	}
+}
