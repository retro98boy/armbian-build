Subject: [PATCH] board: add CoreLab TVPro for Armbian edge

Import TVPro board, DDR and BL30 support from khadas-u-boot f44ace43c4f.
Original board support: retro98boy <retro98boy@qq.com>.
Select the 4GB or 8GB mainline DTB and enable Armbian boot commands.

diff --git a/arch/arm/dts/tvpro.dts b/arch/arm/dts/tvpro.dts
new file mode 100644
index 00000000000..19e999909e8
--- /dev/null
+++ b/arch/arm/dts/tvpro.dts
@@ -0,0 +1,215 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright (c) 2021 Nick <nick@khadas.com>.
+ */
+
+/dts-v1/;
+
+#include "meson-t7-txxx.dtsi"
+#include "khadas-ts050-panel.dtsi"
+
+/ {
+	compatible = "corelab,tvpro","amlogic,t7-an400-lpddr4x", "amlogic,t7-txxx", "amlogic,meson-t7";
+	model = "CoreLab TVPro";
+
+	aliases {
+		serial0 = &uart_a;
+		serial1 = &uart_b;
+		spi0 = &spifc;
+		spi1 = &spicc0;
+		spi2 = &spicc1;
+		spi3 = &spicc2;
+		spi4 = &spicc3;
+		spi5 = &spicc4;
+		spi6 = &spicc5;
+		i2c0 = &i2c0;
+		i2c1 = &i2c1;
+		i2c2 = &i2c2;
+		i2c3 = &i2c3;
+		i2c4 = &i2c4;
+		i2c5 = &i2c5;
+		i2c6 = &i2c_AO_A;
+		i2c7 = &i2c_AO_B;
+	};
+
+	chosen {
+		stdout-path = "serial0:921600n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x0 0x0 0x80000000>;
+	};
+
+	vddio_boot: regulator-vddio_boot {
+		compatible = "regulator-fixed";
+		regulator-name = "VDDIO_BOOT";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+	};
+
+	vddio_ao18: regulator-vddio_ao18 {
+		compatible = "regulator-fixed";
+		regulator-name = "VDDIO_AO18";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+	};
+
+	vcc_3v3: regulator-vcc_3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "VCC_3V3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+	};
+
+	sd_3v3: regulator-sd_3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "SD_3V3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+
+		gpio = <&gpio GPIOD_11 GPIO_ACTIVE_LOW>;
+		startup-delay-us = <100000>;
+		u-boot,off-on-delay-us = <100000>;
+		enable-active-low;
+	};
+
+	emmc_pwrseq: emmc-pwrseq {
+		compatible = "mmc-pwrseq-emmc";
+		/* reset-gpios = <&gpio BOOT_12 GPIO_ACTIVE_LOW>; */
+	};
+
+	tee: tee {
+		compatible = "linaro,optee-tz";
+		method = "smc";
+	};
+};
+
+&ethmac {
+	status = "okay";
+	pinctrl-names = "external_eth_rgmii_pins";
+	pinctrl-0 = <&external_eth_rgmii_pins>;
+	internal_phy = <0>;
+	mc_val = <0x1621>;
+	cali_val = <0xa0000>;
+};
+
+&ir {
+	status = "disabled";
+	/* pinctrl-0 = <&remote_input_ao_pins>; */
+	/* pinctrl-names = "default"; */
+};
+
+&pinctrl_periphs {
+	bl_pwm_off_pins: bl_pwm_off_pin {
+	};
+};
+
+&saradc {
+	status = "okay";
+	vref-supply = <&vddio_ao18>;
+};
+
+&amhdmitx {
+	enc_idx = <2>; /* value can be 0 or 2 */
+};
+
+/* SD card */
+&sd_emmc_b {
+	status = "okay";
+	pinctrl-0 = <&sdcard_pins>;
+	pinctrl-1 = <&sdcard_pins &to_sduart_pins>;
+	pinctrl-names = "sd_all_pins", "sd_uart";
+
+	bus-width = <4>;
+	cap-sd-highspeed;
+	max-frequency = <100000000>;
+	disable-wp;
+
+	cd-gpios = <&gpio GPIOC_6 GPIO_ACTIVE_HIGH>;
+	cd-inverted;
+
+	card_type = <5>;
+
+	init_co_phase = <2>;
+	init_tx_phase = <0>;
+
+	sd_hs_co_phase = <2>;
+	sd_hs_tx_phase = <0>;
+
+	vmmc-supply = <&sd_3v3>;
+};
+
+/* eMMC */
+&sd_emmc_c {
+	status = "okay";
+	pinctrl-0 = <&emmc_pins>;
+	pinctrl-names = "default";
+
+	bus-width = <8>;
+	cap-mmc-highspeed;
+	mmc-hs200-1_8v;
+	max-frequency = <200000000>;
+	non-removable;
+	disable-wp;
+	/* mmc-ddr-1_8v; */
+	card_type = <1>;
+
+	init_co_phase = <2>;
+	init_tx_phase = <0>;
+
+	hs_co_phase = <2>;
+	hs_to_phase = <0>;
+
+	hs2_co_phase = <2>;
+	hs2_to_phase = <0>;
+
+	hw_reset = <&gpio GPIOB_12 GPIO_ACTIVE_HIGH>;
+
+	mmc-pwrseq = <&emmc_pwrseq>;
+	vmmc-supply = <&vcc_3v3>;
+	vqmmc-supply = <&vddio_boot>;
+};
+
+&crg {
+	status = "okay";
+	dr_mode = "host";
+};
+
+&crg2 {
+	status = "okay";
+	dr_mode = "host";
+};
+
+&usb2_phy_v2 {
+	status = "okay";
+	portnum = <1>;
+};
+
+&usb3_phy_v2 {
+	status = "okay";
+	portnum = <0>;
+	gpio-vbus-power = "GPIOH_4";
+	gpios = <&gpio GPIOH_4 GPIO_ACTIVE_HIGH>;
+};
+
+&usb2_phy2_v2 {
+	status = "okay";
+	portnum = <1>;
+};
+
+/*
+ * Do not turn on USB OTG power supply,
+ * because it is used for image burning via A to A cable.
+ */
+&usb3_phy2_v2 {
+	status = "okay";
+	portnum = <0>;
+	/* gpio-vbus-power = "GPIOH_5"; */
+	/* gpios = <&gpio GPIOH_5 GPIO_ACTIVE_HIGH>; */
+};
+
+/* Debug */
+&uart_a {
+	status = "okay";
+};
