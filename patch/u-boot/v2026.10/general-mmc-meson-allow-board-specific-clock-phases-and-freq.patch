From 31bd3350be8a6e416be2b5ef51386197be0b3911 Mon Sep 17 00:00:00 2001
From: retro98boy <retro98boy@qq.com>
Date: Sat, 31 Oct 2026 18:36:50 +0800
Subject: [PATCH] mmc: meson: allow board-specific clock phases and frequency
 limits

Allow per-controller clock phases through amlogic,mmc-phase.
Preserve the existing GX, SM1 and non-DM SPL phase defaults.
Honor max-frequency within the upstream 40 MHz controller limit.
Provide clock-phase constants for imported device trees.
---
 drivers/mmc/meson_gx_mmc.c                    | 41 +++++++++++--------
 drivers/mmc/meson_gx_mmc.h                    |  4 ++
 .../include/dt-bindings/mmc/meson-gx-mmc.h    | 15 +++++++
 3 files changed, 42 insertions(+), 18 deletions(-)
 create mode 100644 dts/upstream/include/dt-bindings/mmc/meson-gx-mmc.h

diff --git a/drivers/mmc/meson_gx_mmc.c b/drivers/mmc/meson_gx_mmc.c
index 76af3873..73576e0d 100644
--- a/drivers/mmc/meson_gx_mmc.c
+++ b/drivers/mmc/meson_gx_mmc.c
@@ -12,6 +12,7 @@
 #include <mmc.h>
 #include <asm/io.h>
 #include <asm/gpio.h>
+#include <linux/bitfield.h>
 #include <linux/delay.h>
 #include <linux/log2.h>
 #include "meson_gx_mmc.h"
@@ -45,6 +46,7 @@ static inline void meson_write(struct mmc *mmc, uint32_t val, int offset)
 
 static void meson_mmc_config_clock(struct mmc *mmc)
 {
+	struct meson_mmc_plat *pdata = mmc->priv;
 	uint32_t meson_mmc_clk = 0;
 	unsigned int clk, clk_src, clk_div;
 
@@ -63,23 +65,7 @@ static void meson_mmc_config_clock(struct mmc *mmc)
 	}
 	clk_div = DIV_ROUND_UP(clk, mmc->clock);
 
-	/*
-	 * SM1 SoCs doesn't work fine over 50MHz with CLK_CO_PHASE_180
-	 * If CLK_CO_PHASE_270 is used, it's more stable than other.
-	 * Other SoCs use CLK_CO_PHASE_180 by default.
-	 * It needs to find what is a proper value about each SoCs.
-	 */
-#if CONFIG_IS_ENABLED(DM_MMC)
-	if (meson_gx_mmc_is_compatible(mmc->dev, MMC_COMPATIBLE_SM1))
-		meson_mmc_clk |= CLK_CO_PHASE_270;
-	else
-		meson_mmc_clk |= CLK_CO_PHASE_180;
-#else /* U-Boot SPL on GX SoCs */
-	meson_mmc_clk |= CLK_CO_PHASE_180;
-#endif
-
-	/* 180 phase tx clock */
-	meson_mmc_clk |= CLK_TX_PHASE_000;
+	meson_mmc_clk |= pdata->clock_phase;
 
 	/* clock settings */
 	meson_mmc_clk |= clk_src;
@@ -285,6 +271,7 @@ struct mmc *meson_mmc_init(int mmc_no)
 	cfg->b_max = 127; /* max 128 - 1 block */
 	cfg->name = "Meson SD/eMMC";
 	cfg->ops = &meson_mmc_ops;
+	pdata->clock_phase = CLK_CO_PHASE_180;
 
 	if (mmc_no == 0) /* MMC1: SD card */
 		pdata->regbase = (void *)0xd0072000;
@@ -314,12 +301,29 @@ static int meson_mmc_of_to_plat(struct udevice *dev)
 {
 	struct meson_mmc_plat *pdata = dev_get_plat(dev);
 	fdt_addr_t addr;
+	u32 phase[3];
+	int ret;
 
 	addr = dev_read_addr(dev);
 	if (addr == FDT_ADDR_T_NONE)
 		return -EINVAL;
 
 	pdata->regbase = (void *)addr;
+	pdata->clock_phase = meson_gx_mmc_is_compatible(dev, MMC_COMPATIBLE_SM1) ?
+		CLK_CO_PHASE_270 : CLK_CO_PHASE_180;
+
+	if (dev_read_prop(dev, "amlogic,mmc-phase", NULL)) {
+		ret = dev_read_u32_array(dev, "amlogic,mmc-phase", phase,
+					ARRAY_SIZE(phase));
+		if (ret)
+			return ret;
+		if (phase[0] > 3 || phase[1] > 3 || phase[2] > 3)
+			return -EINVAL;
+
+		pdata->clock_phase = FIELD_PREP(CLK_CO_PHASE_MASK, phase[0]) |
+			FIELD_PREP(CLK_TX_PHASE_MASK, phase[1]) |
+			FIELD_PREP(CLK_RX_PHASE_MASK, phase[2]);
+	}
 
 	return 0;
 }
@@ -348,7 +352,8 @@ static int meson_mmc_probe(struct udevice *dev)
 	cfg->host_caps = MMC_MODE_8BIT | MMC_MODE_4BIT |
 			MMC_MODE_HS_52MHz | MMC_MODE_HS;
 	cfg->f_min = DIV_ROUND_UP(SD_EMMC_CLKSRC_24M, CLK_MAX_DIV);
-	cfg->f_max = 40000000; /* 40 MHz */
+	cfg->f_max = min_t(u32, dev_read_u32_default(dev, "max-frequency", 40000000),
+			   40000000);
 	cfg->b_max = 511; /* max 512 - 1 blocks */
 	cfg->name = dev->name;
 
diff --git a/drivers/mmc/meson_gx_mmc.h b/drivers/mmc/meson_gx_mmc.h
index 8974b78f..8aaacc44 100644
--- a/drivers/mmc/meson_gx_mmc.h
+++ b/drivers/mmc/meson_gx_mmc.h
@@ -25,6 +25,9 @@ enum meson_gx_mmc_compatible {
 #define   CLK_MAX_DIV			63
 #define   CLK_SRC_24M			(0 << 6)
 #define   CLK_SRC_DIV2			(1 << 6)
+#define   CLK_CO_PHASE_MASK		GENMASK(9, 8)
+#define   CLK_TX_PHASE_MASK		GENMASK(11, 10)
+#define   CLK_RX_PHASE_MASK		GENMASK(13, 12)
 #define   CLK_CO_PHASE_000		(0 << 8)
 #define   CLK_CO_PHASE_090		(1 << 8)
 #define   CLK_CO_PHASE_180		(2 << 8)
@@ -89,6 +92,7 @@ struct meson_mmc_plat {
 	struct mmc mmc;
 	void *regbase;
 	void *w_buf;
+	u32 clock_phase;
 };
 
 #endif
diff --git a/dts/upstream/include/dt-bindings/mmc/meson-gx-mmc.h b/dts/upstream/include/dt-bindings/mmc/meson-gx-mmc.h
new file mode 100644
index 00000000..6f530e44
--- /dev/null
+++ b/dts/upstream/include/dt-bindings/mmc/meson-gx-mmc.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: (GPL-2.0+ OR MIT) */
+/*
+ * Copyright (c) 2022 Vyacheslav Bocharov
+ * Author: Vyacheslav Bocharov <adeep@lexina.in>
+ */
+
+#ifndef _DT_BINDINGS_MESON_GX_MMC_H
+#define _DT_BINDINGS_MESON_GX_MMC_H
+
+#define CLK_PHASE_0	0
+#define CLK_PHASE_90	1
+#define CLK_PHASE_180	2
+#define CLK_PHASE_270	3
+
+#endif
-- 
