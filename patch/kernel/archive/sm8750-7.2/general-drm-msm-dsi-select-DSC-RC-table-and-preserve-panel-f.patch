From c836f1fb4f2159437e1b9a5ecb8292ac003665bd Mon Sep 17 00:00:00 2001
From: retro98boy <retro98boy@qq.com>
Date: Thu, 24 Sep 2026 23:16:58 +0800
Subject: [PATCH 3/3] drm/msm/dsi: select DSC RC table and preserve panel
 first-line budget

---
 drivers/gpu/drm/msm/dsi/dsi_host.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index ca9862848..0f9fbbd46 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -1865,6 +1865,7 @@ static int dsi_host_parse_lane_data(struct msm_dsi_host *msm_host,
 
 static int dsi_populate_dsc_params(struct msm_dsi_host *msm_host, struct drm_dsc_config *dsc)
 {
+	u8 first_line_bpg_offset = dsc->first_line_bpg_offset;
 	int ret;
 
 	if (dsc->bits_per_pixel & 0xf) {
@@ -1896,13 +1897,18 @@ static int dsi_populate_dsc_params(struct msm_dsi_host *msm_host, struct drm_dsc
 	drm_dsc_set_const_params(dsc);
 	drm_dsc_set_rc_buf_thresh(dsc);
 
-	/* DPU supports only pre-SCR panels */
-	ret = drm_dsc_setup_rc_params(dsc, DRM_DSC_1_1_PRE_SCR);
+	/* Use the RC table for the panel's DSC version; retain the 1.1 default. */
+	ret = drm_dsc_setup_rc_params(dsc, dsc->dsc_version_minor == 2 ?
+				      DRM_DSC_1_2_444 : DRM_DSC_1_1_PRE_SCR);
 	if (ret) {
 		DRM_DEV_ERROR(&msm_host->pdev->dev, "could not find DSC RC parameters\n");
 		return ret;
 	}
 
+	/* A panel-specified first-line budget takes precedence over the table. */
+	if (first_line_bpg_offset)
+		dsc->first_line_bpg_offset = first_line_bpg_offset;
+
 	dsc->initial_scale_value = drm_dsc_initial_scale_value(dsc);
 	dsc->line_buf_depth = dsc->bits_per_component + 1;
 
-- 
2.55.0

