+static const struct v4l2_ctrl_ops hantro_h264_enc_ctrl_ops = {
+	.s_ctrl = hantro_h264_enc_s_ctrl,
+};
+
+static int hantro_h264_try_bitrate(struct v4l2_ctrl *ctrl)
+{
+	struct v4l2_ctrl *peak = ctrl->cluster[HANTRO_H264_BITRATE_PEAK];
+	struct v4l2_ctrl *mode = ctrl->cluster[HANTRO_H264_BITRATE_MODE];
+
+	if (mode->val != V4L2_MPEG_VIDEO_BITRATE_MODE_VBR || peak->val >= ctrl->val)
+		return 0;
+
+	if (ctrl->is_new && peak->is_new)
+		return -ERANGE;
+
+	peak->val = ctrl->val;
+	return 0;
+}
+
+static const struct v4l2_ctrl_ops hantro_h264_bitrate_ctrl_ops = {
+	.try_ctrl = hantro_h264_try_bitrate,
+};
+
+static int hantro_h264_try_qp(struct v4l2_ctrl *min_qp)
+{
+	struct v4l2_ctrl *max_qp = min_qp->cluster[HANTRO_H264_MAX_QP];
+
+	if (min_qp->val <= max_qp->val)
+		return 0;
+
+	if (min_qp->is_new && max_qp->is_new)
+		return -ERANGE;
+
+	if (min_qp->is_new)
+		max_qp->val = min_qp->val;
+	else
+		min_qp->val = max_qp->val;
+
+	return 0;
+}
+
+static const struct v4l2_ctrl_ops hantro_h264_qp_ctrl_ops = {
+	.try_ctrl = hantro_h264_try_qp,
+};
