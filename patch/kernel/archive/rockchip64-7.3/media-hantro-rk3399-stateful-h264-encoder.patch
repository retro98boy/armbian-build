+struct vepu2_h264_rbsp {
+	u8 data[ROCKCHIP_VPU2_H264_HEADER_SIZE];
+	unsigned int bits;
+	unsigned int bytes;
+	unsigned int zeros;
+	u8 byte;
+};
+
+static void vepu2_h264_byte(struct vepu2_h264_rbsp *rbsp, u8 byte)
+{
+	if (rbsp->bytes < sizeof(rbsp->data))
+		rbsp->data[rbsp->bytes] = byte;
+	rbsp->bytes++;
+}
+
+static void vepu2_h264_bits(struct vepu2_h264_rbsp *rbsp, unsigned int n, u32 val)
+{
+	while (n--) {
+		rbsp->byte = (rbsp->byte << 1) | ((val >> n) & 1);
+		if (++rbsp->bits != 8)
+			continue;
+
+		/* Escape byte sequences that would resemble a start code. */
+		if (rbsp->zeros == 2 && rbsp->byte <= 3) {
+			vepu2_h264_byte(rbsp, 3);
+			rbsp->zeros = 0;
+		}
+		vepu2_h264_byte(rbsp, rbsp->byte);
+		rbsp->zeros = rbsp->byte ? 0 : rbsp->zeros + 1;
+		rbsp->bits = 0;
+		rbsp->byte = 0;
+	}
