+	vepu2_h264_bits(rbsp, 3, 5);	/* Unspecified video format */
+	vepu2_h264_bits(rbsp, 1, quant == V4L2_QUANTIZATION_FULL_RANGE);
+	vepu2_h264_bits(rbsp, 1, 1);	/* colour_description_present_flag */
+	vepu2_h264_bits(rbsp, 8, primaries);
+	vepu2_h264_bits(rbsp, 8, transfer);
+	vepu2_h264_bits(rbsp, 8, coefficients);
+	vepu2_h264_bits(rbsp, 2, 1);	/* Only timing_info_present_flag */
+	vepu2_h264_bits(rbsp, 32, interval->numerator);
+	vepu2_h264_bits(rbsp, 32, interval->denominator * 2);
+	vepu2_h264_bits(rbsp, 5, 16);	/* Fixed frame rate, other flags clear */
+}
+
+static void vepu2_h264_end_rbsp(struct vepu2_h264_rbsp *rbsp)
+{
+	vepu2_h264_bits(rbsp, 8 - rbsp->bits, BIT(7 - rbsp->bits));
+}
+
+static int vepu2_h264_write_headers(struct hantro_ctx *ctx, u8 *dst)
+{
+	struct vepu2_h264_rbsp rbsp = {};
+	unsigned int w = MB_WIDTH(ctx->src_fmt.width);
+	unsigned int h = MB_HEIGHT(ctx->src_fmt.height);
+	unsigned int crop = h * MB_DIM - ctx->src_fmt.height;
+
+	vepu2_h264_nal(&rbsp, 0x67);
+	vepu2_h264_bits(&rbsp, 8, 66);	/* profile_idc: Baseline */
+	vepu2_h264_bits(&rbsp, 8, 0xc0);	/* Constrained Baseline */
+	vepu2_h264_bits(&rbsp, 8, 42);	/* level_idc: 4.2 */
+	vepu2_h264_ue(&rbsp, 0);		/* seq_parameter_set_id */
+	/* Match the 16-bit frame number in the hardware slice header. */
+	vepu2_h264_ue(&rbsp, 12);		/* log2_max_frame_num_minus4 */
+	vepu2_h264_ue(&rbsp, 2);		/* pic_order_cnt_type */
+	vepu2_h264_ue(&rbsp, 1);		/* max_num_ref_frames */
+	vepu2_h264_bits(&rbsp, 1, 0);	/* gaps_in_frame_num_value_allowed_flag */
+	vepu2_h264_ue(&rbsp, w - 1);
+	vepu2_h264_ue(&rbsp, h - 1);
+	vepu2_h264_bits(&rbsp, 2, 3);	/* frame_mbs_only and direct_8x8_inference */
+	vepu2_h264_bits(&rbsp, 1, !!crop);
+	if (crop) {
+		vepu2_h264_ue(&rbsp, 0);	/* frame_crop_left_offset */
+		vepu2_h264_ue(&rbsp, 0);	/* frame_crop_right_offset */
+		vepu2_h264_ue(&rbsp, 0);	/* frame_crop_top_offset */
+		vepu2_h264_ue(&rbsp, crop / 2);
+	}
+	vepu2_h264_bits(&rbsp, 1, 1);	/* vui_parameters_present_flag */
+	vepu2_h264_write_vui(&rbsp, ctx);
+	vepu2_h264_end_rbsp(&rbsp);
+
+	vepu2_h264_nal(&rbsp, 0x68);
+	vepu2_h264_ue(&rbsp, 0);		/* pic_parameter_set_id */
+	vepu2_h264_ue(&rbsp, 0);		/* seq_parameter_set_id */
+	vepu2_h264_bits(&rbsp, 2, 0);	/* CAVLC, no bottom-field POC */
+	vepu2_h264_ue(&rbsp, 0);		/* num_slice_groups_minus1 */
+	vepu2_h264_ue(&rbsp, 0);		/* num_ref_idx_l0_default_active_minus1 */
+	vepu2_h264_ue(&rbsp, 0);		/* num_ref_idx_l1_default_active_minus1 */
+	vepu2_h264_bits(&rbsp, 3, 0);	/* No weighted prediction */
+	vepu2_h264_ue(&rbsp, 0);		/* pic_init_qp_minus26 */
+	vepu2_h264_ue(&rbsp, 0);		/* pic_init_qs_minus26 */
+	vepu2_h264_ue(&rbsp, 0);		/* chroma_qp_index_offset */
+	vepu2_h264_bits(&rbsp, 3, 4);	/* deblocking_filter_control_present_flag */
+	vepu2_h264_end_rbsp(&rbsp);
+
+	if (rbsp.bytes > sizeof(rbsp.data))
+		return -ENOSPC;
+
+	memcpy(dst, rbsp.data, rbsp.bytes);
+	return rbsp.bytes;
+}
+
+void rockchip_vpu2_h264_enc_exit(struct hantro_ctx *ctx)
+{
+	struct hantro_h264_enc_hw_ctx *enc = &ctx->h264_enc;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(enc->reconstructed); i++) {
+		struct hantro_aux_buf *buf = &enc->reconstructed[i];
+
+		if (!buf->cpu)
+			continue;
+		dma_free_coherent(ctx->dev->dev, buf->size, buf->cpu, buf->dma);
+		buf->cpu = NULL;
+	}
+}
+
+int rockchip_vpu2_h264_enc_init(struct hantro_ctx *ctx)
+{
+	struct hantro_h264_enc_hw_ctx *enc = &ctx->h264_enc;
+	unsigned int i;
+
+	memset(enc, 0, sizeof(*enc));
+	for (i = 0; i < ARRAY_SIZE(enc->reconstructed); i++) {
+		struct hantro_aux_buf *buf = &enc->reconstructed[i];
+
+		buf->size = rockchip_vpu2_rec_luma_size(ctx) * 3 / 2;
+		buf->cpu = dma_alloc_coherent(ctx->dev->dev, buf->size,
+					      &buf->dma, GFP_KERNEL);
+		if (!buf->cpu) {
+			rockchip_vpu2_h264_enc_exit(ctx);
+			return -ENOMEM;
+		}
+	}
+	return 0;
+}
+
+static u32 vepu2_h264_bits_per_frame(struct hantro_ctx *ctx, int bitrate)
+{
+	return div_u64((u64)bitrate * ctx->timeperframe.numerator,
+		       ctx->timeperframe.denominator);
+}
+
+static unsigned int vepu2_h264_select_frame(struct hantro_ctx *ctx)
+{
+	struct hantro_h264_enc_hw_ctx *enc = &ctx->h264_enc;
+	const struct hantro_h264_enc_ctrls *ctrls = &ctx->h264_ctrls;
+	int qp, min_qp, max_qp;
+	u32 target = 0, peak = 0;
+	unsigned int gop;
+
+	v4l2_ctrl_lock(ctrls->gop_size);
+
+	gop = ctrls->gop_size->cur.val;
+	enc->idr = ctx->force_key_frame || !enc->have_ref || enc->frame_num >= gop;
+	ctx->force_key_frame = false;
+
+	min_qp = ctrls->qp[HANTRO_H264_MIN_QP]->cur.val;
+	max_qp = ctrls->qp[HANTRO_H264_MAX_QP]->cur.val;
+	qp = enc->idr ? ctrls->i_frame_qp->cur.val : ctrls->p_frame_qp->cur.val;
+
+	if (ctrls->frame_rc->cur.val) {
+		int bitrate = ctrls->rate[HANTRO_H264_BITRATE]->cur.val;
+		int max_rate = ctrls->rate[HANTRO_H264_BITRATE_PEAK]->cur.val;
+
+		if (ctrls->rate[HANTRO_H264_BITRATE_MODE]->cur.val ==
+		    V4L2_MPEG_VIDEO_BITRATE_MODE_CBR)
+			max_rate = bitrate;
+
+		target = vepu2_h264_bits_per_frame(ctx, bitrate);
+		peak = vepu2_h264_bits_per_frame(ctx, max_rate);
+	}
+
+	v4l2_ctrl_unlock(ctrls->gop_size);
+
+	if (target != enc->target_bits || peak != enc->peak_bits) {
+		enc->bit_debt = 0;
+		enc->qp_delta = 0;
+		enc->target_bits = target;
+		enc->peak_bits = peak;
+	}
+	return clamp(qp + enc->qp_delta, min_qp, max_qp);
+}
+
+static void vepu2_h264_update_rate(struct hantro_h264_enc_hw_ctx *enc, u64 bits)
+{
+	int target = enc->target_bits;
+	int change = 0;
+
+	if (!target)
+		return;
+
+	/* Decay the bit debt between frames. */
+	enc->bit_debt = clamp_t(s64, enc->bit_debt * 7 / 8 + (s64)bits - target,
+				-target * 4, target * 4);
+	if (bits > enc->peak_bits * 2)
+		change = 2;
+	else if (enc->bit_debt > target / 2)
+		change = 1;
+	else if (enc->bit_debt < -target / 2)
+		change = -1;
+
+	enc->qp_delta = clamp(enc->qp_delta + change, -28, 27);
+}
+
+static void rockchip_vpu2_h264_mv_penalty(struct hantro_dev *vpu, unsigned int qp)
+{
+	u32 reg;
+	unsigned int i, j;
+
+	reg = VEPU_REG_4MV_PENALTY(h264_diff_mv_penalty4p[qp]) |
+	      VEPU_REG_1MV_PENALTY(h264_diff_mv_penalty[qp]) |
+	      VEPU_REG_QMV_PENALTY(h264_diff_mv_penalty[qp]) |
+	      VEPU_REG_SPLIT_MV_MODE_EN;
+	vepu_write_relaxed(vpu, reg, VEPU_REG_MV_PENALTY);
+
+	for (i = 0; i < 32; i++) {
+		u32 integer = 0, quarter = 0;
+
+		for (j = 0; j < 4; j++) {
+			unsigned int mv = 4 * i + j;
+
+			integer = (integer << 8) | mv;
+			/* Length of the signed Exp-Golomb code for this distance. */
+			quarter = (quarter << 8) | (2 * fls(2 * mv + !mv) - 1);
+		}
+		vepu_write_relaxed(vpu, integer, VEPU_REG_DMV_PENALTY_TBL(i));
+		vepu_write_relaxed(vpu, quarter,
+				   VEPU_REG_DMV_Q_PIXEL_PENALTY_TBL(i));
+	}
+}
+
+int rockchip_vpu2_h264_enc_run(struct hantro_ctx *ctx)
+{
+	struct hantro_dev *vpu = ctx->dev;
+	struct hantro_h264_enc_hw_ctx *enc = &ctx->h264_enc;
+	struct vb2_v4l2_buffer *dst_vbuf = hantro_get_dst_buf(ctx);
+	struct vb2_buffer *dst = &dst_vbuf->vb2_buf;
+	struct vb2_buffer *src = &hantro_get_src_buf(ctx)->vb2_buf;
+	const struct v4l2_pix_format_mplane *fmt = &ctx->src_fmt;
+	const struct hantro_aux_buf *rec = &enc->reconstructed[enc->next_rec];
+	const struct hantro_aux_buf *reference = &enc->reconstructed[enc->next_rec ^ 1];
+	unsigned int width_mbs = MB_WIDTH(fmt->width);
+	unsigned int height_mbs = MB_HEIGHT(fmt->height);
+	unsigned int luma = rockchip_vpu2_rec_luma_size(ctx);
+	unsigned int aligned_prefix, remainder, i, qp, stride;
+	dma_addr_t input;
+	u8 stream_prefix[8] = {};
+	u8 *dst_addr = vb2_plane_vaddr(dst, 0);
+	size_t limit;
+	u32 reg;
+
+	if (!dst_addr || vb2_plane_size(dst, 0) < ROCKCHIP_VPU2_H264_HEADER_SIZE + 8)
+		return -EINVAL;
+
+	qp = vepu2_h264_select_frame(ctx);
+	/* Mark the reference valid only after successful completion. */
+	enc->have_ref = false;
+	enc->prefix = 0;
+	if (enc->idr) {
+		int prefix = vepu2_h264_write_headers(ctx, dst_addr);
+
+		if (prefix < 0)
+			return prefix;
+
+		enc->frame_num = 0;
+		enc->idr_pic_id = (enc->idr_pic_id + 1) & 15;
+		reference = rec;
+		enc->prefix = prefix;
+	}
+
+	aligned_prefix = round_down(enc->prefix, sizeof(stream_prefix));
+	remainder = enc->prefix - aligned_prefix;
+
+	hantro_start_prepare_run(ctx);
+
+	/* Pass the trailing header bytes to VEPU2 for its first 64-bit write. */
+	memcpy(stream_prefix, dst_addr + aligned_prefix, remainder);
+	/* This register accepts a byte limit and reports a bit count. */
+	limit = min_t(size_t, vb2_plane_size(dst, 0) - aligned_prefix, U32_MAX / 8);
+	limit = round_down(limit, 8);
+	enc->stream_limit = limit;
+
+	vepu_write_relaxed(vpu, VEPU_REG_ENCODE_FORMAT_H264,
+			   VEPU_REG_ENCODE_START);
+	vepu_write_relaxed(vpu, VEPU_REG_AXI_CTRL_BURST_LEN(16),
+			   VEPU_REG_AXI_CTRL);
+	vepu_write_relaxed(vpu, VEPU_REG_OUTPUT_SWAP32 | VEPU_REG_OUTPUT_SWAP16 |
+			   VEPU_REG_OUTPUT_SWAP8 | VEPU_REG_INPUT_SWAP32 |
+			   VEPU_REG_INPUT_SWAP16 | VEPU_REG_INPUT_SWAP8,
+			   VEPU_REG_DATA_ENDIAN);
+
+	stride = fmt->plane_fmt[0].bytesperline;
+	if (fmt->pixelformat == V4L2_PIX_FMT_YUYV ||
+	    fmt->pixelformat == V4L2_PIX_FMT_UYVY)
+		stride /= 2;
+	vepu_write_relaxed(vpu, VEPU_REG_IN_IMG_CTRL_ROW_LEN(stride),
+			   VEPU_REG_INPUT_LUMA_INFO);
+	input = vb2_dma_contig_plane_dma_addr(src, 0);
+	/* Use mapped addresses on unused inputs to avoid IOMMU faults. */
+	for (i = 0; i < 3; i++) {
+		dma_addr_t plane = i < fmt->num_planes ?
+				   vb2_dma_contig_plane_dma_addr(src, i) : input;
+
+		if (i == 1 && fmt->pixelformat == V4L2_PIX_FMT_NV12)
+			plane += stride * fmt->height;
+
+		vepu_write_relaxed(vpu, plane,
+				   VEPU_REG_ADDR_IN_PLANE_0 + i * sizeof(u32));
+	}
+
+	vepu_write_relaxed(vpu, rec->dma, VEPU_REG_ADDR_REC_LUMA);
+	vepu_write_relaxed(vpu, rec->dma + luma, VEPU_REG_ADDR_REC_CHROMA);
+	vepu_write_relaxed(vpu, reference->dma,
+			   VEPU_REG_ADDR_REF_LUMA);
+	vepu_write_relaxed(vpu, reference->dma + luma,
+			   VEPU_REG_ADDR_REF_CHROMA);
+	vepu_write_relaxed(vpu, rec->dma, VEPU_REG_ADDR_CABAC_TBL);
+
+	vepu_write_relaxed(vpu, get_unaligned_be32(stream_prefix),
+			   VEPU_REG_STR_HDR_REM_MSB);
+	vepu_write_relaxed(vpu, get_unaligned_be32(stream_prefix + 4),
+			   VEPU_REG_STR_HDR_REM_LSB);
+	vepu_write_relaxed(vpu, limit, VEPU_REG_STR_BUF_LIMIT);
+	vepu_write_relaxed(vpu, vb2_dma_contig_plane_dma_addr(dst, 0) +
+			   aligned_prefix, VEPU_REG_ADDR_OUTPUT_STREAM);
+	vepu_write_relaxed(vpu, 0, VEPU_REG_ADDR_OUTPUT_CTRL);
+
+	reg = VEPU_REG_INTRA_AREA_TOP(height_mbs) |
+	      VEPU_REG_INTRA_AREA_BOTTOM(height_mbs) |
+	      VEPU_REG_INTRA_AREA_LEFT(width_mbs) |
+	      VEPU_REG_INTRA_AREA_RIGHT(width_mbs);
+	vepu_write_relaxed(vpu, reg, VEPU_REG_INTRA_AREA_CTRL);
+
+	reg = 0;
+	if (width_mbs * height_mbs > 3600)
+		reg |= VEPU_REG_DISABLE_QUARTER_PIXEL_MV;
+	vepu_write_relaxed(vpu, reg, VEPU_REG_ENC_CTRL0);
+	vepu_write_relaxed(vpu, VEPU_REG_IN_IMG_CTRL_FMT(ctx->vpu_src_fmt->enc_fmt),
+			   VEPU_REG_ENC_CTRL1);
+
+	reg = VEPU_REG_PPS_INIT_QP(VEPU2_H264_PPS_QP) |
+	      VEPU_REG_IDR_PIC_ID(enc->idr_pic_id);
+	vepu_write_relaxed(vpu, reg, VEPU_REG_ENC_CTRL2);
+
+	reg = VEPU_REG_INTRA_PRED_MODE(h264_pred_mode_favor[qp]) |
+	      VEPU_REG_FRAME_NUM(enc->frame_num);
+	vepu_write_relaxed(vpu, reg, VEPU_REG_ENC_CTRL3);
+
+	reg = min(255U, h264_skip_sad_penalty[qp] *
+		  max(1U, 200 / (width_mbs + height_mbs)));
+	reg = VEPU_REG_STREAM_START_OFFSET(remainder * 8) |
+	      VEPU_REG_SKIP_MACROBLOCK_PENALTY(reg) |
+	      VEPU_REG_IN_IMG_CTRL_OVRFLB(height_mbs * MB_DIM - fmt->height);
+	vepu_write_relaxed(vpu, reg, VEPU_REG_ENC_OVER_FILL_STRM_OFFSET);
+	vepu_write_relaxed(vpu, VEPU_REG_ZERO_MV_FAVOR_D2(10), VEPU_REG_MVC_RELATE);
+	reg = VEPU_REG_INTRA16X16_MODE(h264_intra16_favor[qp]) |
+	      VEPU_REG_INTER_MODE(h264_inter_favor[qp]);
+	vepu_write_relaxed(vpu, reg, VEPU_REG_INTRA_INTER_MODE);
+	vepu_write_relaxed(vpu, 0, VEPU_QP_ADJUST_MAD_DELTA_ROI);
+	reg = VEPU_REG_H264_LUMA_INIT_QP(qp) |
+	      VEPU_REG_H264_QP_MAX(qp) | VEPU_REG_H264_QP_MIN(qp);
+	vepu_write_relaxed(vpu, reg, VEPU_REG_QP_VAL);
+
+	rockchip_vpu2_h264_mv_penalty(vpu, qp);
+	vepu_write_relaxed(vpu, 0, VEPU_REG_ROI1);
+	vepu_write_relaxed(vpu, 0, VEPU_REG_ROI2);
+	vepu_write_relaxed(vpu, input, VEPU_REG_ADDR_NEXT_PIC);
+	vepu_write_relaxed(vpu, 0, VEPU_REG_ADDR_MV_OUT);
+	vepu_write_relaxed(vpu, 0, VEPU_REG_STABILIZATION_OUTPUT);
+	vepu_write_relaxed(vpu, VEPU_REG_INTERRUPT_TIMEOUT_EN, VEPU_REG_INTERRUPT);
+
+	reg = VEPU_REG_MB_HEIGHT(height_mbs) | VEPU_REG_MB_WIDTH(width_mbs) |
+	      VEPU_REG_ENCODE_FORMAT_H264 | VEPU_REG_ENCODE_ENABLE;
+	if (enc->idr)
+		reg |= VEPU_REG_FRAME_TYPE_INTRA;
+
+	hantro_end_prepare_run(ctx);
+	vepu_write(vpu, reg, VEPU_REG_ENCODE_START);
+	return 0;
+}
+
+void rockchip_vpu2_h264_enc_done(struct hantro_ctx *ctx)
+{
+	struct hantro_h264_enc_hw_ctx *enc = &ctx->h264_enc;
+	struct vb2_v4l2_buffer *dst = hantro_get_dst_buf(ctx);
+	unsigned int bytesused;
+	u32 bits;
+
+	bits = vepu_read(ctx->dev, VEPU_REG_STR_BUF_LIMIT);
+	if (bits > enc->stream_limit * 8)
+		return;
+
+	bytesused = round_down(enc->prefix, 8) + DIV_ROUND_UP(bits, 8);
+	if (bytesused <= enc->prefix)
+		return;
+
+	vb2_set_plane_payload(&dst->vb2_buf, 0, bytesused);
+	dst->flags &= ~(V4L2_BUF_FLAG_KEYFRAME | V4L2_BUF_FLAG_PFRAME |
+			V4L2_BUF_FLAG_BFRAME);
+	dst->flags |= enc->idr ? V4L2_BUF_FLAG_KEYFRAME : V4L2_BUF_FLAG_PFRAME;
+
+	enc->frame_num++;
+	enc->next_rec ^= 1;
+	enc->have_ref = true;
+	vepu2_h264_update_rate(enc, (u64)bytesused * 8);
+}
