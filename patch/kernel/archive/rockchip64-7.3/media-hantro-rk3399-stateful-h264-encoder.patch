+static int hantro_h264_enc_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct hantro_ctx *ctx = container_of(ctrl->handler, struct hantro_ctx,
+					     ctrl_handler);
+
+	ctx->force_key_frame = true;
+	return 0;
+}
