#include "rk3568-zc-3568d.dts"

/ {
	model = "Zhuoce ZC-3568D P1";
	compatible = "zhuoce,zc-3568d-p1", "zhuoce,zc-3568d", "rockchip,rk3568";

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm5 0 25000 0>;
		enable-gpios = <&gpio3 RK_PC7 GPIO_ACTIVE_HIGH>;
		post-pwm-on-delay-ms = <10>;
		default-brightness-level = <200>;
		brightness-levels = <
			   0  321  321  321  321  322  322  322
			 323  323  324  324  325  326  327  328
			 329  330  331  332  334  335  337  339
			 340  342  344  346  348  351  353  356
			 358  361  364  366  369  372  376  379
			 382  386  389  393  397  401  405  409
			 413  418  422  427  432  436  441  446
			 451  457  462  468  473  479  485  491
			 497  503  509  516  522  529  536  543
			 550  557  564  571  579  587  594  602
			 610  618  627  635  643  652  661  670
			 679  688  697  706  716  725  735  745
			 755  765  775  786  796  807  817  828
			 839  850  862  873  885  896  908  920
			 932  944  956  969  981  994 1007 1020
			1033 1046 1060 1073 1087 1100 1114 1128
			1143 1157 1171 1186 1200 1215 1230 1245
			1261 1276 1292 1307 1323 1339 1355 1371
			1387 1404 1421 1437 1454 1471 1488 1506
			1523 1541 1558 1576 1594 1612 1631 1649
			1668 1686 1705 1724 1743 1763 1782 1802
			1821 1841 1861 1881 1901 1922 1942 1963
			1984 2005 2026 2047 2069 2090 2112 2134
			2156 2178 2200 2223 2245 2268 2291 2314
			2337 2360 2384 2407 2431 2455 2479 2503
			2527 2552 2576 2601 2626 2651 2676 2702
			2727 2753 2779 2804 2831 2857 2883 2910
			2936 2963 2990 3017 3045 3072 3100 3127
			3155 3183 3212 3240 3268 3297 3326 3355
			3384 3413 3442 3472 3502 3532 3562 3592
			3622 3652 3683 3714 3745 3776 3807 3838
			3870 3902 3933 3965 3998 4030 4062 4095
		>;
	};

	vcc3v3_lcd: regulator-vcc3v3-lcd {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_lcd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio3 RK_PC6 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		vin-supply = <&vcc3v3_sys>;
	};
};

&dsi_dphy0 {
	status = "okay";
};

&dsi0 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	panel@0 {
		compatible = "rocknix,generic-dsi";
		reg = <0>;
		backlight = <&backlight>;
		enable-gpios = <&gpio3 RK_PD1 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio2 RK_PC4 GPIO_ACTIVE_LOW>;
		reset1-gpios = <&gpio3 RK_PA7 GPIO_ACTIVE_LOW>;
		vdd-supply = <&vcc3v3_lcd>;
		iovcc-supply = <&vcc3v3_sys>;
		panel_description =
			"G size=330,200 delays=10,100,100,100,0 format=rgb888 lanes=4 flags=0xa03",
			/*
			 * Horizontal total: 1920 + 216 + 44 + 20 = 2200.
			 * Vertical total: 1080 + 20 + 5 + 20 = 1125.
			 * Pixel clock: 2200 * 1125 * 60 Hz = 148500000 Hz.
			 * The clock field uses kHz: 148500000 / 1000 = 148500.
			 */
			"M clock=148500 horizontal=1920,216,44,20 vertical=1080,20,5,20 default=1",
			"I generic=27aa wait=3",
			"I generic=4802 wait=3",
			"I generic=b620 wait=3",
			"I generic=0180 wait=3",
			"I generic=0238 wait=3",
			"I generic=0347 wait=3",
			"I generic=04a0 wait=3",
			"I generic=0514 wait=3",
			"I generic=0664 wait=3",
			"I generic=0700 wait=3",
			"I generic=080a wait=3",
			"I generic=090a wait=3",
			"I generic=0a19 wait=3",
			"I generic=0b82 wait=3",
			"I generic=0c13 wait=3",
			"I generic=0d01 wait=3",
			"I generic=0e80 wait=3",
			"I generic=0f20 wait=3",
			"I generic=1020 wait=3",
			"I generic=1103 wait=3",
			"I generic=121b wait=3",
			"I generic=1353 wait=3",
			"I generic=1401 wait=3",
			"I generic=1523 wait=3",
			"I generic=1640 wait=3",
			"I generic=1700 wait=3",
			"I generic=1801 wait=3",
			"I generic=1923 wait=3",
			"I generic=1a40 wait=3",
			"I generic=1b00 wait=3",
			"I generic=1e46 wait=3",
			"I generic=5130 wait=3",
			"I generic=1f10 wait=3",
			"I generic=2a01 wait=3";

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi0_out_panel>;
			};
		};
	};
};

&dsi0_in {
	dsi0_in_vp1: endpoint {
		remote-endpoint = <&vp1_out_dsi0>;
	};
};

&dsi0_out {
	dsi0_out_panel: endpoint {
		remote-endpoint = <&panel_in>;
	};
};

&pwm5 {
	status = "okay";
};

/*
 * Mainline DCLK rate changes do not program the parent PLL.
 * Initialize VPLL to 594 MHz to leave the 24 MHz oscillator bypass.
 * VP1 divides VPLL by four to generate the 148.5 MHz pixel clock.
 * Zero entries skip the corresponding parent or frequency assignment.
 */
&vop {
	assigned-clocks = <&cru DCLK_VOP0>, <&cru PLL_VPLL>, <&cru DCLK_VOP1>;
	assigned-clock-parents = <&pmucru PLL_HPLL>, <0>, <&cru PLL_VPLL>;
	assigned-clock-rates = <0>, <594000000>, <148500000>;
};

&vp1 {
	vp1_out_dsi0: endpoint@ROCKCHIP_VOP2_EP_MIPI0 {
		reg = <ROCKCHIP_VOP2_EP_MIPI0>;
		remote-endpoint = <&dsi0_in_vp1>;
	};
};
