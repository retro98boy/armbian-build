Subject: media: rkisp1: use transmitter CSI-2 link parameters

Configure the CSI-2 receiver from the transmitter link frequency and
active lane count. Keep pixel rate as the fallback for sensors.
---
diff --git a/drivers/media/platform/rockchip/rkisp1/rkisp1-csi.c b/drivers/media/platform/rockchip/rkisp1/rkisp1-csi.c
--- a/drivers/media/platform/rockchip/rkisp1/rkisp1-csi.c
+++ b/drivers/media/platform/rockchip/rkisp1/rkisp1-csi.c
@@ -15,7 +15,7 @@
 #include <linux/phy/phy.h>
 #include <linux/phy/phy-mipi-dphy.h>
 
-#include <media/v4l2-ctrls.h>
+#include <media/v4l2-common.h>
 #include <media/v4l2-fwnode.h>
 
 #include "rkisp1-common.h"
@@ -36,14 +36,6 @@
 {
 	struct rkisp1_csi *csi = &rkisp1->csi;
 	int ret;
-
-	s_asd->pixel_rate_ctrl = v4l2_ctrl_find(sd->ctrl_handler,
-						V4L2_CID_PIXEL_RATE);
-	if (!s_asd->pixel_rate_ctrl) {
-		dev_err(rkisp1->dev, "No pixel rate control in subdev %s\n",
-			sd->name);
-		return -EINVAL;
-	}
 
 	/* Create the link from the sensor to the CSI receiver. */
 	ret = media_create_pad_link(&sd->entity, source_pad,
@@ -58,12 +50,10 @@
 	return 0;
 }
 
-static int rkisp1_csi_config(struct rkisp1_csi *csi,
-			     const struct rkisp1_sensor_async *sensor,
+static int rkisp1_csi_config(struct rkisp1_csi *csi, unsigned int lanes,
 			     const struct rkisp1_mbus_info *format)
 {
 	struct rkisp1_device *rkisp1 = csi->rkisp1;
-	unsigned int lanes = sensor->lanes;
 	u32 mipi_ctrl;
 
 	if (lanes < 1 || lanes > 4)
@@ -147,30 +137,43 @@
 }
 
 static int rkisp1_csi_start(struct rkisp1_csi *csi,
-			    const struct rkisp1_sensor_async *sensor,
+			    const struct media_pad *source_pad,
+			    unsigned int max_lanes,
 			    const struct rkisp1_mbus_info *format)
 {
 	struct rkisp1_device *rkisp1 = csi->rkisp1;
 	union phy_configure_opts opts;
 	struct phy_configure_opts_mipi_dphy *cfg = &opts.mipi_dphy;
-	s64 pixel_clock;
-	int ret;
-
-	ret = rkisp1_csi_config(csi, sensor, format);
-	if (ret)
-		return ret;
-
-	pixel_clock = v4l2_ctrl_g_ctrl_int64(sensor->pixel_rate_ctrl);
-	if (!pixel_clock) {
-		dev_err(rkisp1->dev, "Invalid pixel rate value\n");
-		return -EINVAL;
-	}
-
-	phy_mipi_dphy_get_default_config(pixel_clock, format->bus_width,
-					 sensor->lanes, cfg);
-	phy_set_mode(csi->dphy, PHY_MODE_MIPI_DPHY);
-	phy_configure(csi->dphy, &opts);
-	phy_power_on(csi->dphy);
+	s64 link_freq;
+	int lanes, ret;
+
+	lanes = v4l2_get_active_data_lanes(source_pad, max_lanes);
+	if (lanes < 0)
+		return lanes;
+
+	link_freq = v4l2_get_link_freq(source_pad, format->bus_width, 2 * lanes);
+	if (link_freq < 0)
+		return dev_err_probe(rkisp1->dev, link_freq,
+				     "cannot get CSI-2 link frequency\n");
+
+	ret = phy_mipi_dphy_get_default_config_for_hsclk(2 * link_freq,
+						      lanes, cfg);
+	if (ret)
+		return ret;
+
+	ret = rkisp1_csi_config(csi, lanes, format);
+	if (ret)
+		return ret;
+
+	ret = phy_set_mode(csi->dphy, PHY_MODE_MIPI_DPHY);
+	if (ret)
+		return ret;
+	ret = phy_configure(csi->dphy, &opts);
+	if (ret)
+		return ret;
+	ret = phy_power_on(csi->dphy);
+	if (ret)
+		return ret;
 
 	rkisp1_csi_enable(csi);
 
@@ -392,7 +395,7 @@
 	format = rkisp1_mbus_info_get_by_code(sink_fmt->code);
 	v4l2_subdev_unlock_state(sd_state);
 
-	ret = rkisp1_csi_start(csi, source_asd, format);
+	ret = rkisp1_csi_start(csi, source_pad, source_asd->lanes, format);
 	if (ret)
 		return ret;
 
diff --git a/drivers/media/platform/rockchip/rkisp1/rkisp1-common.h b/drivers/media/platform/rockchip/rkisp1/rkisp1-common.h
--- a/drivers/media/platform/rockchip/rkisp1/rkisp1-common.h
+++ b/drivers/media/platform/rockchip/rkisp1/rkisp1-common.h
@@ -178,7 +178,6 @@
  * @mbus_type:		type of bus (currently only CSI2 is supported)
  * @mbus_flags:		media bus (V4L2_MBUS_*) flags
  * @sd:			a pointer to v4l2_subdev struct of the sensor
- * @pixel_rate_ctrl:	pixel rate of the sensor, used to initialize the phy
  * @port:		port number (0: MIPI, 1: Parallel)
  */
 struct rkisp1_sensor_async {
@@ -189,7 +188,6 @@
 	enum v4l2_mbus_type mbus_type;
 	unsigned int mbus_flags;
 	struct v4l2_subdev *sd;
-	struct v4l2_ctrl *pixel_rate_ctrl;
 	unsigned int port;
 };
 
