@@ -367,6 +369,116 @@ put_mux_devs:
 }
 EXPORT_SYMBOL_GPL(fwnode_typec_mux_get);
 
+static struct device *typec_mux_link_provider(struct device *consumer,
+					      const struct fwnode_handle *fwnode,
+					      bool audio)
+{
+	struct device *dev, *provider;
+	int ret = -EPROBE_DEFER;
+
+	dev = class_find_device(&typec_mux_class, NULL, fwnode, mux_fwnode_match);
+	if (!dev)
+		return ERR_PTR(ret);
+
+	provider = dev->parent;
+	/* Supplier unbind can wait for the consumer's probe lock. */
+	if (!device_trylock(provider))
+		goto put_dev;
+	if (!device_is_bound(provider) || !device_is_registered(dev))
+		goto unlock;
+	if (audio && !to_typec_mux_dev(dev)->set_audio) {
+		ret = -EOPNOTSUPP;
+		goto unlock;
+	}
+	if (audio && !try_module_get(to_typec_mux_dev(dev)->owner))
+		goto unlock;
+
+	if (!device_link_add(consumer, provider, DL_FLAG_AUTOPROBE_CONSUMER)) {
+		if (audio)
+			module_put(to_typec_mux_dev(dev)->owner);
+		ret = -EINVAL;
+		goto unlock;
+	}
+	device_unlock(provider);
+
+	return dev;
+
+unlock:
+	device_unlock(provider);
+put_dev:
+	put_device(dev);
+	return ERR_PTR(ret);
+}
+
+/**
+ * fwnode_typec_mux_link_suppliers - Link a probing device to connector muxes
+ * @consumer: Device that uses the muxes
+ * @connector: Firmware node of the USB Type-C connector
+ * @compatible: Compatible string of mux suppliers to link
+ *
+ * Keep the links across driver unbind so the suppliers can reprobe the consumer.
+ *
+ * Return: 0 on success or a negative error code.
+ */
+int fwnode_typec_mux_link_suppliers(struct device *consumer,
+				    const struct fwnode_handle *connector,
+				    const char *compatible)
+{
+	struct fwnode_handle *ep;
+
+	fwnode_graph_for_each_endpoint(connector, ep) {
+		struct fwnode_handle *mux __free(fwnode_handle) =
+			fwnode_graph_get_remote_port_parent(ep);
+		struct device *dev;
+
+		if (!fwnode_device_is_available(mux) ||
+		    !fwnode_device_is_compatible(mux, compatible) ||
+		    !fwnode_property_present(mux, "mode-switch"))
+			continue;
+
+		dev = typec_mux_link_provider(consumer, mux, false);
+		if (IS_ERR(dev)) {
+			fwnode_handle_put(ep);
+			return PTR_ERR(dev);
+		}
+		put_device(dev);
+	}
+	return 0;
+}
+EXPORT_SYMBOL_GPL(fwnode_typec_mux_link_suppliers);
+
+/**
+ * fwnode_typec_mux_get_direct - Find a mux on a specific firmware node
+ * @consumer: Device that uses the mux
+ * @fwnode: Firmware node of the mux provider
+ *
+ * Link the consumer to the provider so the consumer unbinds first.
+ * Release the returned handle with typec_mux_put().
+ *
+ * Return: the mux handle or an error pointer.
+ */
+struct typec_mux *fwnode_typec_mux_get_direct(struct device *consumer,
+					      const struct fwnode_handle *fwnode)
+{
+	struct typec_mux *mux;
+	struct device *dev;
+
+	mux = kzalloc_obj(*mux);
+	if (!mux)
+		return ERR_PTR(-ENOMEM);
+
+	dev = typec_mux_link_provider(consumer, fwnode, true);
+	if (IS_ERR(dev)) {
+		kfree(mux);
+		return ERR_CAST(dev);
+	}
+
+	mux->mux_devs[0] = to_typec_mux_dev(dev);
+	mux->num_mux_devs = 1;
+	return mux;
+}
+EXPORT_SYMBOL_GPL(fwnode_typec_mux_get_direct);
+
 /**
  * typec_mux_put - Release handle to a Multiplexer
  * @mux: USB Type-C Connector Multiplexer/DeMultiplexer
@@ -383,7 +495,7 @@ void typec_mux_put(struct typec_mux *mux)
 
 	for (i = 0; i < mux->num_mux_devs; i++) {
 		mux_dev = mux->mux_devs[i];
-		module_put(mux_dev->dev.parent->driver->owner);
+		module_put(mux_dev->owner);
 		put_device(&mux_dev->dev);
 	}
 	kfree(mux);
@@ -402,6 +514,8 @@ int typec_mux_set(struct typec_mux *mux, struct typec_mux_state *state)
 	for (i = 0; i < mux->num_mux_devs; i++) {
 		mux_dev = mux->mux_devs[i];
 
+		if (!mux_dev->set)
+			continue;
 		ret = mux_dev->set(mux_dev, state);
 		if (ret && ret != -EOPNOTSUPP)
 			return ret;
@@ -411,8 +525,24 @@ int typec_mux_set(struct typec_mux *mux, struct typec_mux_state *state)
 }
 EXPORT_SYMBOL_GPL(typec_mux_set);
 
+int typec_mux_set_audio(struct typec_mux *mux, struct typec_audio_route *route,
+			bool connected)
+{
+	struct typec_mux_dev *mux_dev;
+
+	if (!mux || mux->num_mux_devs != 1)
+		return -EINVAL;
+	mux_dev = mux->mux_devs[0];
+	if (!mux_dev->set_audio)
+		return -EOPNOTSUPP;
+
+	return mux_dev->set_audio(mux_dev, route, connected);
+}
+EXPORT_SYMBOL_GPL(typec_mux_set_audio);
+
 static void typec_mux_release(struct device *dev)
 {
+	put_device(dev->parent);
 	kfree(to_typec_mux_dev(dev));
 }
 
@@ -437,7 +567,7 @@ typec_mux_register(struct device *parent, const struct typec_mux_desc *desc)
 	struct typec_mux_dev *mux_dev;
 	int ret;
 
-	if (!desc || !desc->set)
+	if (!desc || (!desc->set && !desc->set_audio))
 		return ERR_PTR(-EINVAL);
 
 	mux_dev = kzalloc_obj(*mux_dev);
@@ -445,9 +575,12 @@ typec_mux_register(struct device *parent, const struct typec_mux_desc *desc)
 		return ERR_PTR(-ENOMEM);
 
 	mux_dev->set = desc->set;
+	if (parent && parent->driver)
+		mux_dev->owner = parent->driver->owner;
+	mux_dev->set_audio = desc->set_audio;
 
 	device_initialize(&mux_dev->dev);
-	mux_dev->dev.parent = parent;
+	mux_dev->dev.parent = get_device(parent);
 	mux_dev->dev.fwnode = desc->fwnode;
 	mux_dev->dev.class = &typec_mux_class;
 	mux_dev->dev.type = &typec_mux_dev_type;
diff --git a/drivers/usb/typec/mux.h b/drivers/usb/typec/mux.h
index 58f0f28b6dc84d35df8e6cc9f01e752799f1e44a..d6120f5c23bbc698eb07c2b9665d377f4cb218a7 100644
--- a/drivers/usb/typec/mux.h
+++ b/drivers/usb/typec/mux.h
@@ -7,12 +7,15 @@
 
 struct typec_switch_dev {
 	struct device dev;
+	struct module *owner;
 	typec_switch_set_fn_t set;
 };
 
 struct typec_mux_dev {
 	struct device dev;
+	struct module *owner;
 	typec_mux_set_fn_t set;
+	typec_mux_set_audio_fn_t set_audio;
 };
 
 #define to_typec_switch_dev(_dev_) container_of(_dev_, struct typec_switch_dev, dev)
diff --git a/drivers/usb/typec/mux/fsa4480.c b/drivers/usb/typec/mux/fsa4480.c
index bea0c1deec94d5a69d2eb9020db95939cdf33e15..8cae6670b240da1770dc14349b004f9476f0055b 100644
--- a/drivers/usb/typec/mux/fsa4480.c
+++ b/drivers/usb/typec/mux/fsa4480.c
@@ -9,6 +9,7 @@
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
+#include <linux/property.h>
 #include <linux/regmap.h>
 #include <linux/usb/typec_dp.h>
 #include <linux/usb/typec_mux.h>
@@ -60,12 +61,18 @@ struct fsa4480 {
 
 	struct regmap *regmap;
 
+	struct typec_mux *codec;
+	struct typec_audio_route audio_route;
+	/* Serialize mux programming and codec notification. */
+	struct mutex mode_lock;
+
 	enum typec_orientation orientation;
 	unsigned long mode;
 	unsigned int svid;
 
 	u8 cur_enable;
 	bool swap_sbu_lanes;
+	bool audio_reversed;
 };
 
 static const struct regmap_config fsa4480_regmap_config = {
@@ -76,6 +83,47 @@ static const struct regmap_config fsa4480_regmap_config = {
 	.disable_locking = true,
 };
 
+static int fsa4480_program_switch(struct fsa4480 *fsa, u8 enable, u8 sel)
+{
+	unsigned int old_sel;
+	int ret, restore;
+
+	ret = regmap_read(fsa->regmap, FSA4480_SWITCH_SELECT, &old_sel);
+	if (ret)
+		return ret;
+
+	if (fsa->cur_enable & FSA4480_ENABLE_SBU) {
+		ret = regmap_write(fsa->regmap, FSA4480_SWITCH_ENABLE,
+				   fsa->cur_enable & ~FSA4480_ENABLE_SBU);
+		if (ret)
+			goto restore_enable;
+		usleep_range(35, 1000);
+	}
+
+	ret = regmap_write(fsa->regmap, FSA4480_SWITCH_SELECT, sel);
+	if (!ret)
+		ret = regmap_write(fsa->regmap, FSA4480_SWITCH_ENABLE, enable);
+	if (ret) {
+		restore = regmap_write(fsa->regmap, FSA4480_SWITCH_SELECT, old_sel);
+		if (restore)
+			dev_err_ratelimited(&fsa->client->dev, "failed to restore switch selection: %d\n",
+					    restore);
+		goto restore_enable;
+	}
+
+	if (enable & FSA4480_ENABLE_SBU)
+		usleep_range(15, 1000);
+	fsa->cur_enable = enable;
+	return 0;
+
+restore_enable:
+	restore = regmap_write(fsa->regmap, FSA4480_SWITCH_ENABLE, fsa->cur_enable);
+	if (restore)
+		dev_err_ratelimited(&fsa->client->dev, "failed to restore switch enable: %d\n",
+				    restore);
+	return ret;
+}
+
 static int fsa4480_set(struct fsa4480 *fsa)
 {
 	bool reverse = (fsa->orientation == TYPEC_ORIENTATION_REVERSE);
@@ -114,11 +162,19 @@ static int fsa4480_set(struct fsa4480 *fsa)
 			return -EOPNOTSUPP;
 		}
 	} else if (fsa->mode == TYPEC_MODE_AUDIO) {
-		/* Audio Accessory Mode, setup to auto Jack Detection */
 		enable |= FSA4480_ENABLE_USB | FSA4480_ENABLE_AGND;
+		/* DIO4480 needs explicit MIC, ground and sense routing. */
+		if (fsa->codec) {
+			enable |= FSA4480_ENABLE_SENSE | FSA4480_ENABLE_MIC;
+			if (fsa->audio_reversed)
+				sel = FSA4480_SEL_SENSE | FSA4480_SEL_MIC | FSA4480_SEL_AGND;
+		}
 	} else
 		return -EOPNOTSUPP;
 
+	if (fsa->codec)
+		return fsa4480_program_switch(fsa, enable, sel);
+
 	if (fsa->cur_enable & FSA4480_ENABLE_SBU) {
 		/* Disable SBU output while re-configuring the switch */
 		regmap_write(fsa->regmap, FSA4480_SWITCH_ENABLE,
@@ -146,18 +202,67 @@ static int fsa4480_set(struct fsa4480 *fsa)
 	return 0;
 }
 
+static int fsa4480_audio_connect(struct typec_audio_route *route)
+{
+	struct fsa4480 *fsa = container_of(route, struct fsa4480, audio_route);
+	unsigned long old_mode;
+	unsigned int old_svid;
+	bool old_reversed;
+	int ret;
+
+	mutex_lock(&fsa->lock);
+	old_mode = fsa->mode;
+	old_svid = fsa->svid;
+	old_reversed = fsa->audio_reversed;
+	fsa->audio_reversed = (fsa->orientation == TYPEC_ORIENTATION_REVERSE) ^
+			      fsa->swap_sbu_lanes;
+	fsa->mode = TYPEC_MODE_AUDIO;
+	fsa->svid = 0;
+	ret = fsa4480_set(fsa);
+	if (ret) {
+		fsa->mode = old_mode;
+		fsa->svid = old_svid;
+		fsa->audio_reversed = old_reversed;
+	}
+	mutex_unlock(&fsa->lock);
+
+	return ret;
+}
+
+static bool fsa4480_audio_swap(struct typec_audio_route *route)
+{
+	struct fsa4480 *fsa = container_of(route, struct fsa4480, audio_route);
+	int ret = -ENODEV;
+
+	mutex_lock(&fsa->lock);
+	if (!fsa->svid && fsa->mode == TYPEC_MODE_AUDIO) {
+		fsa->audio_reversed = !fsa->audio_reversed;
+		ret = fsa4480_set(fsa);
+		if (ret)
+			fsa->audio_reversed = !fsa->audio_reversed;
+	}
+	mutex_unlock(&fsa->lock);
+
+	return !ret;
+}
+
 static int fsa4480_switch_set(struct typec_switch_dev *sw,
 			      enum typec_orientation orientation)
 {
 	struct fsa4480 *fsa = typec_switch_get_drvdata(sw);
+	enum typec_orientation old_orientation;
 	int ret = 0;
 
 	mutex_lock(&fsa->lock);
 
 	if (fsa->orientation != orientation) {
+		old_orientation = fsa->orientation;
 		fsa->orientation = orientation;
 
-		ret = fsa4480_set(fsa);
+		if (!fsa->codec || fsa->svid || fsa->mode != TYPEC_MODE_AUDIO)
+			ret = fsa4480_set(fsa);
+		if (ret && fsa->codec)
+			fsa->orientation = old_orientation;
 	}
 
 	mutex_unlock(&fsa->lock);
@@ -165,27 +270,68 @@ static int fsa4480_switch_set(struct typec_switch_dev *sw,
 	return ret;
 }
 
-static int fsa4480_mux_set(struct typec_mux_dev *mux, struct typec_mux_state *state)
+static int fsa4480_leave_audio(struct fsa4480 *fsa)
 {
-	struct fsa4480 *fsa = typec_mux_get_drvdata(mux);
+	int attempt, ret;
+
+	/* Keep the route reserved until the switch disconnects the audio lines. */
+	for (attempt = 0; attempt < 3; attempt++) {
+		if (attempt)
+			usleep_range(1000, 2000);
+		ret = fsa4480_set(fsa);
+		if (!ret || ret == -EOPNOTSUPP)
+			return ret;
+	}
+	dev_err_ratelimited(&fsa->client->dev, "failed to disconnect audio route: %d\n", ret);
+	return ret;
+}
+
+static int fsa4480_set_mode(struct fsa4480 *fsa, struct typec_mux_state *state)
+{
+	unsigned long old_mode;
+	unsigned int old_svid;
+	bool leaving_audio;
 	int ret = 0;
 
+	if (fsa->codec && !state->alt && state->mode == TYPEC_MODE_AUDIO)
+		return typec_mux_set_audio(fsa->codec, &fsa->audio_route, true);
+
 	mutex_lock(&fsa->lock);
 
-	if (fsa->mode != state->mode) {
+	leaving_audio = fsa->codec && !fsa->svid && fsa->mode == TYPEC_MODE_AUDIO;
+	/* Audio and DisplayPort can use the same numeric mode. */
+	if (fsa->mode != state->mode || leaving_audio) {
+		old_mode = fsa->mode;
+		old_svid = fsa->svid;
 		fsa->mode = state->mode;
-
-		if (state->alt)
-			fsa->svid = state->alt->svid;
+		fsa->svid = state->alt ? state->alt->svid : 0;
+		if (leaving_audio)
+			ret = fsa4480_leave_audio(fsa);
 		else
-			fsa->svid = 0; // No SVID
-
-		ret = fsa4480_set(fsa);
+			ret = fsa4480_set(fsa);
+		if (ret && fsa->codec) {
+			fsa->mode = old_mode;
+			fsa->svid = old_svid;
+		}
 	}
 
 	mutex_unlock(&fsa->lock);
 
-	return ret;
+	if (ret || !leaving_audio)
+		return ret;
+
+	return typec_mux_set_audio(fsa->codec, &fsa->audio_route, false);
+}
+
+static int fsa4480_mux_set(struct typec_mux_dev *mux, struct typec_mux_state *state)
+{
+	struct fsa4480 *fsa = typec_mux_get_drvdata(mux);
+
+	if (!fsa->codec)
+		return fsa4480_set_mode(fsa, state);
+
+	guard(mutex)(&fsa->mode_lock);
+	return fsa4480_set_mode(fsa, state);
 }
 
 enum {
@@ -250,6 +396,22 @@ out_error:
 	return ret;
 }
 
+static struct typec_mux *fsa4480_get_codec(struct device *dev)
+{
+	struct fwnode_handle *ep, *codec;
+	struct typec_mux *mux = NULL;
+
+	ep = fwnode_graph_get_endpoint_by_id(dev_fwnode(dev), 0, 1, 0);
+	if (!ep)
+		return NULL;
+	codec = fwnode_graph_get_remote_port_parent(ep);
+	fwnode_handle_put(ep);
+	if (fwnode_property_present(codec, "mode-switch"))
+		mux = fwnode_typec_mux_get_direct(dev, codec);
+	fwnode_handle_put(codec);
+	return mux;
+}
+
 static int fsa4480_probe(struct i2c_client *client)
 {
 	struct device *dev = &client->dev;
@@ -287,6 +449,18 @@ static int fsa4480_probe(struct i2c_client *client)
 		FIELD_GET(FSA4480_DEVICE_ID_REV_ID, val),
 		FIELD_GET(FSA4480_DEVICE_ID_VENDOR_ID, val));
 
+	if (device_is_compatible(dev, "dioo,dio4480")) {
+		/* DIO4480 needs the codec to select and check the audio route. */
+		fsa->codec = fsa4480_get_codec(dev);
+		if (IS_ERR(fsa->codec))
+			return dev_err_probe(dev, PTR_ERR(fsa->codec),
+					     "failed to acquire codec mode-switch\n");
+
+		mutex_init(&fsa->mode_lock);
+		fsa->audio_route.connect = fsa4480_audio_connect;
+		fsa->audio_route.swap_mic_gnd = fsa4480_audio_swap;
+	}
