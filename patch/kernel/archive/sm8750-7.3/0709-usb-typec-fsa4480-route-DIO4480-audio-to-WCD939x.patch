 	}
 
@@ -146,7 +146,7 @@ void typec_switch_put(struct typec_switch *sw)
 	for (i = 0; i < sw->num_sw_devs; i++) {
 		sw_dev = sw->sw_devs[i];
 
-		module_put(sw_dev->dev.parent->driver->owner);
+		module_put(sw_dev->owner);
 		put_device(&sw_dev->dev);
