index 37f87d3d6b926d76bc136968aed7a8c1ecd5d9a1..4734a97bc4edc6f0d5b03f32c08953b429302b58 100644
--- a/drivers/usb/typec/mux.c
+++ b/drivers/usb/typec/mux.c
@@ -109,7 +109,7 @@ struct typec_switch *fwnode_typec_switch_get(struct fwnode_handle *fwnode)
 	}
 
 	for (i = 0; i < count; i++) {
-		WARN_ON(!try_module_get(sw_devs[i]->dev.parent->driver->owner));
+		WARN_ON(!try_module_get(sw_devs[i]->owner));
