@@ -188,6 +188,8 @@ typec_switch_register(struct device *parent,
 		return ERR_PTR(-ENOMEM);
 
 	sw_dev->set = desc->set;
+	if (parent && parent->driver)
+		sw_dev->owner = parent->driver->owner;
 
 	device_initialize(&sw_dev->dev);
 	sw_dev->dev.parent = parent;
@@ -347,7 +349,7 @@ struct typec_mux *fwnode_typec_mux_get(struct fwnode_handle *fwnode)
 	}
 
 	for (i = 0; i < count; i++) {
