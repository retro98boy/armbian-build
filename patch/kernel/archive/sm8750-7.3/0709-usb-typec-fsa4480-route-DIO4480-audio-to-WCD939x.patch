From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: retro98boy <retro98boy@qq.com>
Date: Mon, 23 Nov 2026 17:47:13 +0800
Subject: [PATCH] usb: typec: fsa4480: route DIO4480 audio to WCD939x

DIO4480 needs explicit microphone and ground routing. Use the DIO4480
compatible and the codec graph connection to select this path.
Let WCD939x select one route when switches share the same headset lines.

Replay the selected route if an accessory connects before jack setup.
Use the codec orientation switch for USBSS only.
Send audio callbacks to the codec endpoint. Use device links to unbind
UCSI and DP Alt Mode before the switches. Retry a failed disconnect
before releasing the route.

Based on the FSA4480 codec notification work by Luca Weiss and Val Packett.

Link: https://lore.kernel.org/all/20261020162101.1527014-3-val@packett.cool/
Signed-off-by: retro98boy <retro98boy@qq.com>
---
diff --git a/drivers/soc/qcom/pmic_glink_altmode.c b/drivers/soc/qcom/pmic_glink_altmode.c
index b94c79e4a9a058521cb626f6f23de24ec5cde211..ebbf80e8174d8a0259bf941b1ed27ad429aff0fd 100644
--- a/drivers/soc/qcom/pmic_glink_altmode.c
+++ b/drivers/soc/qcom/pmic_glink_altmode.c
@@ -631,6 +631,13 @@ static int pmic_glink_altmode_probe(struct auxiliary_device *adev,
 		alt_port->tbt_alt.mode = TYPEC_TBT_MODE;
 		alt_port->tbt_alt.active = 1;
 
+		ret = fwnode_typec_mux_link_suppliers(dev, fwnode, "dioo,dio4480");
+		if (ret) {
+			fwnode_handle_put(fwnode);
+			return dev_err_probe(dev, ret, "failed to link mux for port %u\n",
+					     port);
+		}
+
 		alt_port->typec_mux = fwnode_typec_mux_get(fwnode);
 		if (IS_ERR(alt_port->typec_mux)) {
 			fwnode_handle_put(fwnode);
@@ -712,11 +719,24 @@ static int pmic_glink_altmode_probe(struct auxiliary_device *adev,
 	if (IS_ERR(altmode->client))
 		return PTR_ERR(altmode->client);
 
+	dev_set_drvdata(dev, altmode);
 	pmic_glink_client_register(altmode->client);
 
 	return 0;
 }
 
+static void pmic_glink_altmode_remove(struct auxiliary_device *adev)
+{
+	struct pmic_glink_altmode *altmode = dev_get_drvdata(&adev->dev);
+	unsigned int i;
+
+	/* GLINK callbacks can queue work until devres releases the client. */
+	disable_work_sync(&altmode->enable_work);
+	for (i = 0; i < ARRAY_SIZE(altmode->ports); i++)
+		if (altmode->ports[i].altmode)
+			disable_work_sync(&altmode->ports[i].work);
+}
+
 static const struct auxiliary_device_id pmic_glink_altmode_id_table[] = {
 	{ .name = "pmic_glink.altmode", },
 	{},
@@ -726,6 +746,7 @@ MODULE_DEVICE_TABLE(auxiliary, pmic_glink_altmode_id_table);
 static struct auxiliary_driver pmic_glink_altmode_driver = {
 	.name = "pmic_glink_altmode",
 	.probe = pmic_glink_altmode_probe,
+	.remove = pmic_glink_altmode_remove,
 	.id_table = pmic_glink_altmode_id_table,
 };
 
