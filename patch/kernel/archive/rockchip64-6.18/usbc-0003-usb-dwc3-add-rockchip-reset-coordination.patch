From: retro98boy <retro98boy@qq.com>
Subject: [PATCH] usb: dwc3: Add Rockchip platform reset coordination

Keep Rockchip PHY reset handling outside the common DWC3 core.
Hold PIPE in soft reset while the shared PHY changes configuration.

Based on Sebastian Reichel's Rockchip platform driver.
Link: https://lore.kernel.org/all/20260813-rockchip-usbdp-cleanup-v14-29-b5ad9c68fa11@collabora.com/
Link: https://lore.kernel.org/all/20260813-rockchip-usbdp-cleanup-v14-31-b5ad9c68fa11@collabora.com/

Signed-off-by: retro98boy <retro98boy@qq.com>
---
 drivers/usb/dwc3/core.c          |    6 +
 drivers/usb/dwc3/Kconfig         |   11 ++
 drivers/usb/dwc3/Makefile        |    1 
 drivers/usb/dwc3/dwc3-rockchip.c |  222 ++++++++++++++++++++++++++++++++++++++
 drivers/usb/dwc3/trace.c         |    3 +
 5 files changed, 243 insertions(+)

diff --git a/drivers/usb/dwc3/core.c b/drivers/usb/dwc3/core.c
--- a/drivers/usb/dwc3/core.c
+++ b/drivers/usb/dwc3/core.c
@@ -2417,6 +2417,12 @@
 	struct resource *res;
 	struct dwc3 *dwc;
 
+	/* Prefer the platform driver when it is enabled. */
+	if (IS_ENABLED(CONFIG_USB_DWC3_ROCKCHIP) &&
+	    (device_is_compatible(&pdev->dev, "rockchip,rk3588-dwc3") ||
+	     device_is_compatible(&pdev->dev, "rockchip,rk3576-dwc3")))
+		return -ENODEV;
+
 	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
 	if (!res) {
 		dev_err(&pdev->dev, "missing memory resource\n");
diff --git a/drivers/usb/dwc3/Kconfig b/drivers/usb/dwc3/Kconfig
--- a/drivers/usb/dwc3/Kconfig
+++ b/drivers/usb/dwc3/Kconfig
@@ -178,6 +178,17 @@
 	  Only the host mode is currently supported.
 	  Say 'Y' or 'M' here if you have one such device.
 
+config USB_DWC3_ROCKCHIP
+	tristate "Rockchip DWC3 Platform Driver"
+	depends on ARCH_ROCKCHIP || COMPILE_TEST
+	depends on OF
+	default USB_DWC3
+	help
+	  Support RK3576 and RK3588 DesignWare USB3 controllers.
+	  Coordinate PHY resets during USB Type-C orientation changes.
+	  Support host and dual-role controller configurations.
+	  The module is named dwc3-rockchip.
+
 config USB_DWC3_RTK
 	tristate "Realtek DWC3 Platform Driver"
 	depends on OF && ARCH_REALTEK
diff --git a/drivers/usb/dwc3/Makefile b/drivers/usb/dwc3/Makefile
--- a/drivers/usb/dwc3/Makefile
+++ b/drivers/usb/dwc3/Makefile
@@ -56,5 +56,6 @@
 obj-$(CONFIG_USB_DWC3_IMX8MP)		+= dwc3-imx8mp.o
 obj-$(CONFIG_USB_DWC3_XILINX)		+= dwc3-xilinx.o
 obj-$(CONFIG_USB_DWC3_OCTEON)		+= dwc3-octeon.o
+obj-$(CONFIG_USB_DWC3_ROCKCHIP)		+= dwc3-rockchip.o
 obj-$(CONFIG_USB_DWC3_RTK)		+= dwc3-rtk.o
 obj-$(CONFIG_USB_DWC3_GENERIC_PLAT)	+= dwc3-generic-plat.o
diff --git a/drivers/usb/dwc3/dwc3-rockchip.c b/drivers/usb/dwc3/dwc3-rockchip.c
new file mode 100644
--- /dev/null
+++ b/drivers/usb/dwc3/dwc3-rockchip.c
@@ -0,0 +1,222 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Copyright (c) 2026, Collabora Ltd. */
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include "glue.h"
+#include "io.h"
+
+struct dwc3_rockchip_phy {
+	struct notifier_block nb;
+	struct dwc3 *dwc;
+	struct phy *phy;
+	u8 port;
+	bool active;
+	bool pm_ref;
+};
+
+struct dwc3_rockchip {
+	struct dwc3 dwc;
+	struct dwc3_rockchip_phy phys[DWC3_USB3_MAX_PORTS];
+};
+
+static int dwc3_rockchip_phy_notify(struct notifier_block *nb,
+				    unsigned long action, void *data)
+{
+	struct dwc3_rockchip_phy *reset = container_of(nb, struct dwc3_rockchip_phy, nb);
+	struct dwc3 *dwc = reset->dwc;
+	unsigned long flags;
+	u32 value;
+	int ret;
+
+	switch (action) {
+	case PHY_NOTIFY_PRE_RESET:
+		/* A forced runtime resume calls phy_init() and deadlocks the provider. */
+		ret = pm_runtime_get_if_active(dwc->dev);
+		if (!ret)
+			return NOTIFY_OK;
+		if (ret < 0 && ret != -EINVAL)
+			return notifier_from_errno(ret);
+		/* System resume can disable runtime PM while the core is active. */
+		if (ret == -EINVAL && pm_runtime_status_suspended(dwc->dev))
+			return NOTIFY_OK;
+
+		spin_lock_irqsave(&dwc->lock, flags);
+		reset->active = true;
+		reset->pm_ref = ret > 0;
+		value = dwc3_readl(dwc, DWC3_GUSB3PIPECTL(reset->port));
+		value |= DWC3_GUSB3PIPECTL_PHYSOFTRST;
+		dwc3_writel(dwc, DWC3_GUSB3PIPECTL(reset->port), value);
+		spin_unlock_irqrestore(&dwc->lock, flags);
+		break;
+	case PHY_NOTIFY_POST_RESET:
+		spin_lock_irqsave(&dwc->lock, flags);
+		if (!reset->active) {
+			spin_unlock_irqrestore(&dwc->lock, flags);
+			return NOTIFY_OK;
+		}
+		reset->active = false;
+		value = dwc3_readl(dwc, DWC3_GUSB3PIPECTL(reset->port));
+		value &= ~DWC3_GUSB3PIPECTL_PHYSOFTRST;
+		dwc3_writel(dwc, DWC3_GUSB3PIPECTL(reset->port), value);
+		spin_unlock_irqrestore(&dwc->lock, flags);
+		if (reset->pm_ref) {
+			reset->pm_ref = false;
+			pm_runtime_put_autosuspend(dwc->dev);
+		}
+		break;
+	}
+
+	return NOTIFY_OK;
+}
+
+static void dwc3_rockchip_unregister_phys(struct dwc3 *dwc)
+{
+	struct dwc3_rockchip *rk = container_of(dwc, struct dwc3_rockchip, dwc);
+	struct dwc3_rockchip_phy *reset;
+	int i;
+
+	for (i = 0; i < dwc->num_usb3_ports; i++) {
+		reset = &rk->phys[i];
+		if (!reset->phy)
+			continue;
+		phy_unregister_notifier(reset->phy, &reset->nb);
+		/* Probe failure can leave clocks disabled. Do not access registers here. */
+		if (reset->pm_ref) {
+			reset->pm_ref = false;
+			pm_runtime_put_noidle(dwc->dev);
+		}
+		reset->active = false;
+		reset->phy = NULL;
+	}
+}
+
+static int dwc3_rockchip_register_phys(struct dwc3 *dwc)
+{
+	struct dwc3_rockchip *rk = container_of(dwc, struct dwc3_rockchip, dwc);
+	struct dwc3_rockchip_phy *reset;
+	struct phy *phy;
+	int i, ret;
+
+	for (i = 0; i < dwc->num_usb3_ports; i++) {
+		phy = dwc->usb3_generic_phy[i];
+		if (!phy)
+			continue;
+		reset = &rk->phys[i];
+		reset->dwc = dwc;
+		reset->port = i;
+		reset->nb.notifier_call = dwc3_rockchip_phy_notify;
+		ret = phy_register_notifier(phy, &reset->nb);
+		if (ret) {
+			dwc3_rockchip_unregister_phys(dwc);
+			return ret;
+		}
+		reset->phy = phy;
+	}
+
+	return 0;
+}
+
+static const struct dwc3_glue_ops dwc3_rockchip_glue_ops = {
+	.post_phy_registration = dwc3_rockchip_register_phys,
+};
+
+static int dwc3_rockchip_probe(struct platform_device *pdev)
+{
+	struct dwc3_probe_data probe_data = {};
+	struct dwc3_rockchip *rk;
+	struct resource *res;
+	int ret;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return dev_err_probe(&pdev->dev, -ENODEV, "Missing memory resource\n");
+
+	rk = devm_kzalloc(&pdev->dev, sizeof(*rk), GFP_KERNEL);
+	if (!rk)
+		return -ENOMEM;
+
+	rk->dwc.dev = &pdev->dev;
+	rk->dwc.glue_ops = &dwc3_rockchip_glue_ops;
+	probe_data.dwc = &rk->dwc;
+	probe_data.res = res;
+	ret = dwc3_core_probe(&probe_data);
+	if (ret)
+		dwc3_rockchip_unregister_phys(&rk->dwc);
+	return ret;
+}
+
+static void dwc3_rockchip_remove(struct platform_device *pdev)
+{
+	struct dwc3 *dwc = platform_get_drvdata(pdev);
+
+	/* Keep registers accessible while draining reset notifications. */
+	pm_runtime_get_sync(dwc->dev);
+	dwc3_rockchip_unregister_phys(dwc);
+	dwc3_core_remove(dwc);
+	pm_runtime_put_noidle(&pdev->dev);
+}
+
+static int __maybe_unused dwc3_rockchip_runtime_suspend(struct device *dev)
+{
+	return dwc3_runtime_suspend(dev_get_drvdata(dev));
+}
+
+static int __maybe_unused dwc3_rockchip_runtime_resume(struct device *dev)
+{
+	return dwc3_runtime_resume(dev_get_drvdata(dev));
+}
+
+static int __maybe_unused dwc3_rockchip_runtime_idle(struct device *dev)
+{
+	return dwc3_runtime_idle(dev_get_drvdata(dev));
+}
+
+static int __maybe_unused dwc3_rockchip_suspend(struct device *dev)
+{
+	return dwc3_pm_suspend(dev_get_drvdata(dev));
+}
+
+static int __maybe_unused dwc3_rockchip_resume(struct device *dev)
+{
+	return dwc3_pm_resume(dev_get_drvdata(dev));
+}
+
+static void __maybe_unused dwc3_rockchip_complete(struct device *dev)
+{
+	dwc3_pm_complete(dev_get_drvdata(dev));
+}
+
+static int __maybe_unused dwc3_rockchip_prepare(struct device *dev)
+{
+	return dwc3_pm_prepare(dev_get_drvdata(dev));
+}
+
+static const struct dev_pm_ops dwc3_rockchip_pm_ops = {
+	SYSTEM_SLEEP_PM_OPS(dwc3_rockchip_suspend, dwc3_rockchip_resume)
+	.complete = pm_sleep_ptr(dwc3_rockchip_complete),
+	.prepare = pm_sleep_ptr(dwc3_rockchip_prepare),
+	RUNTIME_PM_OPS(dwc3_rockchip_runtime_suspend, dwc3_rockchip_runtime_resume,
+		       dwc3_rockchip_runtime_idle)
+};
+
+static const struct of_device_id dwc3_rockchip_of_match[] = {
+	{ .compatible = "rockchip,rk3588-dwc3" },
+	{ .compatible = "rockchip,rk3576-dwc3" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, dwc3_rockchip_of_match);
+
+static struct platform_driver dwc3_rockchip_driver = {
+	.probe = dwc3_rockchip_probe,
+	.remove = dwc3_rockchip_remove,
+	.driver = {
+		.name = "dwc3-rockchip",
+		.pm = pm_ptr(&dwc3_rockchip_pm_ops),
+		.of_match_table = dwc3_rockchip_of_match,
+	},
+};
+module_platform_driver(dwc3_rockchip_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("DesignWare DWC3 Rockchip platform driver");
diff --git a/drivers/usb/dwc3/trace.c b/drivers/usb/dwc3/trace.c
--- a/drivers/usb/dwc3/trace.c
+++ b/drivers/usb/dwc3/trace.c
@@ -9,3 +9,6 @@
 
 #define CREATE_TRACE_POINTS
 #include "trace.h"
+
+EXPORT_TRACEPOINT_SYMBOL_GPL(dwc3_readl);
+EXPORT_TRACEPOINT_SYMBOL_GPL(dwc3_writel);
