From: retro98boy <retro98boy@qq.com>
Subject: [PATCH] phy: rockchip: usbdp: Apply Type-C orientation changes

Reinitialize active PHY lanes when the Type-C orientation changes.
Coordinate resets with consumers and preserve their power state.

Link: https://lore.kernel.org/all/20260915-rockchip-usbdp-cleanup-part2-v15-3-8d507cb1174f@collabora.com/

Signed-off-by: retro98boy <retro98boy@qq.com>
---
 drivers/phy/rockchip/phy-rockchip-usbdp.c |   78 ++++++++++++++++-------------
 1 file changed, 44 insertions(+), 34 deletions(-)

diff --git a/drivers/phy/rockchip/phy-rockchip-usbdp.c b/drivers/phy/rockchip/phy-rockchip-usbdp.c
--- a/drivers/phy/rockchip/phy-rockchip-usbdp.c
+++ b/drivers/phy/rockchip/phy-rockchip-usbdp.c
@@ -651,10 +651,14 @@
 	udphy->mode = UDPHY_MODE_DP_USB;
 }
 
+static int rk_udphy_power_on(struct rk_udphy *udphy, u8 mode);
+
 static int rk_udphy_orien_sw_set(struct typec_switch_dev *sw,
 				 enum typec_orientation orien)
 {
 	struct rk_udphy *udphy = typec_switch_get_drvdata(sw);
+	bool flipped = orien == TYPEC_ORIENTATION_REVERSE;
+	int ret = 0;
 
 	mutex_lock(&udphy->mutex);
 
@@ -666,13 +670,23 @@
 		goto unlock_ret;
 	}
 
-	udphy->flip = orien == TYPEC_ORIENTATION_REVERSE;
+	if (udphy->flip != flipped || udphy->mode != UDPHY_MODE_DP_USB)
+		udphy->mode_change = true;
+
+	udphy->flip = flipped;
 	rk_udphy_set_typec_default_mapping(udphy);
+
+	/* DWC3 can keep the USB PHY initialized across cable detach. */
+	if (udphy->status & UDPHY_MODE_USB) {
+		ret = rk_udphy_power_on(udphy, UDPHY_MODE_USB);
+		if (ret)
+			goto unlock_ret;
+	}
 	rk_udphy_usb_bvalid_enable(udphy, true);
 
 unlock_ret:
 	mutex_unlock(&udphy->mutex);
-	return 0;
+	return ret;
 }
 
 static void rk_udphy_orien_switch_unregister(void *data)
@@ -999,39 +1013,38 @@
 		return 0;
 	}
 
-	if (udphy->status == UDPHY_MODE_NONE) {
-		udphy->mode_change = false;
-		ret = rk_udphy_setup(udphy);
-		if (ret)
-			return ret;
-
-		if (udphy->mode & UDPHY_MODE_USB)
-			rk_udphy_u3_port_disable(udphy, false);
-	} else if (udphy->mode_change) {
-		udphy->mode_change = false;
-		udphy->status = UDPHY_MODE_NONE;
-		if (udphy->mode == UDPHY_MODE_DP)
-			rk_udphy_u3_port_disable(udphy, true);
-
-		rk_udphy_disable(udphy);
-		ret = rk_udphy_setup(udphy);
-		if (ret)
-			return ret;
-	}
-
+	if (udphy->status && !udphy->mode_change)
+		goto out;
+
+	ret = phy_notify_reset(udphy->phy_u3, PHY_NOTIFY_PRE_RESET);
+	if (ret)
+		goto notify;
+
+	/* Keep xHCI clocked from UTMI while the PHY restarts. */
+	rk_udphy_u3_port_disable(udphy, true);
+	udelay(10);
+
+	/* Preserve clocks and consumer state when reconfiguring an active PHY. */
+	ret = udphy->status ? rk_udphy_init(udphy) : rk_udphy_setup(udphy);
+	if (ret)
+		goto notify;
+
+	if (!udphy->hs && (udphy->mode & UDPHY_MODE_USB))
+		rk_udphy_u3_port_disable(udphy, false);
+	udphy->mode_change = false;
+notify:
+	phy_notify_reset(udphy->phy_u3, PHY_NOTIFY_POST_RESET);
+	if (ret)
+		return ret;
+out:
 	udphy->status |= mode;
-
 	return 0;
 }
 
 static void rk_udphy_power_off(struct rk_udphy *udphy, u8 mode)
 {
-	if (!(udphy->mode & mode)) {
-		dev_info(udphy->dev, "mode 0x%02x is not support\n", mode);
-		return;
-	}
-
-	if (!udphy->status)
+	/* Consumer state survives a change in lane allocation. */
+	if (!(udphy->status & mode))
 		return;
 
 	udphy->status &= ~mode;
@@ -1200,6 +1213,8 @@
 	struct phy_configure_opts_dp *dp = &opts->dp;
 	u32 i, val, lane;
 	int ret;
+
+	guard(mutex)(&udphy->mutex);
 
 	if (dp->set_rate) {
 		ret = rk_udphy_dp_phy_verify_link_rate(udphy, dp);
@@ -1324,13 +1339,8 @@
 	struct rk_udphy *udphy = phy_get_drvdata(phy);
 
 	mutex_lock(&udphy->mutex);
-	/* DP only or high-speed */
-	if (!(udphy->mode & UDPHY_MODE_USB) || udphy->hs)
-		goto unlock;
-
 	rk_udphy_power_off(udphy, UDPHY_MODE_USB);
 
-unlock:
 	mutex_unlock(&udphy->mutex);
 	return 0;
 }
