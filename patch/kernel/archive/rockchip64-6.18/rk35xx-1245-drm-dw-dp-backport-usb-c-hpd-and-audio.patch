+#define RK3588_DP_SINK_HPD_SEL		BIT(10)
+#define RK3588_DP_SINK_HPD_CFG		BIT(11)
+#define RK3588_DP_SINK_HPD_MASK		(RK3588_DP_SINK_HPD_SEL | RK3588_DP_SINK_HPD_CFG)
+
 struct rockchip_dw_dp {
 	struct dw_dp *base;
 	struct device *dev;
 	struct rockchip_encoder encoder;
+	struct regmap *vo_grf;
+	u32 hpd_reg;
 };
 
+static void dw_dp_rockchip_set_hpd(void *data, bool high)
+{
+	struct rockchip_dw_dp *dp = data;
+	u32 value = RK3588_DP_SINK_HPD_MASK << 16;
+	int ret;
+
+	value |= RK3588_DP_SINK_HPD_SEL;
+	if (high)
+		value |= RK3588_DP_SINK_HPD_CFG;
+
+	ret = regmap_write(dp->vo_grf, dp->hpd_reg, value);
+	if (ret)
+		dev_err_ratelimited(dp->dev, "Failed to set DP HPD: %d\n", ret);
+}
+
+static void dw_dp_rockchip_init_hpd(struct rockchip_dw_dp *dp,
+				    struct dw_dp_plat_data *pdata)
+{
+	struct platform_device *pdev = to_platform_device(dp->dev);
+	struct device_node *node = dp->dev->of_node;
+	struct of_phandle_args phy;
+	struct resource *res;
+
+	if (!of_device_is_compatible(node, "rockchip,rk3588-dp"))
+		return;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return;
+
+	switch (res->start) {
+	case 0xfde50000:
+		dp->hpd_reg = 0;
+		break;
+	case 0xfde60000:
+		dp->hpd_reg = 8;
+		break;
+	default:
+		return;
+	}
+
+	if (of_parse_phandle_with_args(node, "phys", "#phy-cells", 0, &phy))
+		return;
+
+	dp->vo_grf = syscon_regmap_lookup_by_phandle(phy.np, "rockchip,vo-grf");
+	of_node_put(phy.np);
+	if (IS_ERR(dp->vo_grf))
+		return;
+
+	pdata->data = dp;
+	pdata->set_hpd = dw_dp_rockchip_set_hpd;
+}
