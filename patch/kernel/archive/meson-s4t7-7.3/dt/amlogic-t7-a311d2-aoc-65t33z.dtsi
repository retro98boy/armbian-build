#include "amlogic-t7.dtsi"
#include <dt-bindings/gpio/amlogic,t7-periphs-pinctrl.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "AOC 65T33Z";
	compatible = "aoc,65t33z", "amlogic,a311d2", "amlogic,t7";

	aliases {
		serial0 = &uart_a;
		mmc0 = &sd_emmc_c;
		rtc0 = &vrtc;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* 3 MiB reserved for ARM Trusted Firmware (BL31) */
		secmon_reserved: secmon@5000000 {
			reg = <0x0 0x05000000 0x0 0x300000>;
			no-map;
		};

		/* 32 MiB reserved for ARM Trusted Firmware (BL32) */
		secmon_reserved_bl32: secmon@5300000 {
			reg = <0x0 0x05300000 0x0 0x2000000>;
			no-map;
		};

	};

	dc_in: regulator-dc-in {
		compatible = "regulator-fixed";
		regulator-name = "DC_IN";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};

	vdd_ddr: regulator-vddddr {
		/*
		 * SY8003ADFC Regulator.
		 */
		compatible = "pwm-regulator";
		regulator-name = "VDDDDR";
		regulator-min-microvolt = <690000>;
		regulator-max-microvolt = <890000>;
		pwm-supply = <&dc_in>;
		pwms = <&pwm_ao_gh 0 1500 0>;
		pwm-dutycycle-range = <100 0>;
		regulator-boot-on;
		regulator-always-on;
	};

	vdd_ee: regulator-vddee {
		/*
		 * MP8756GD Regulator.
		 */
		compatible = "pwm-regulator";
		regulator-name = "VDDEE";
		regulator-min-microvolt = <700000>;
		regulator-max-microvolt = <922000>;
		pwm-supply = <&dc_in>;
		pwms = <&pwm_ao_ab 0 1500 0>;
		pwm-dutycycle-range = <100 0>;
		regulator-boot-on;
		regulator-always-on;
	};

	vdd_gpu: regulator-vddgpu {
		/*
		 * SY8003ADFC Regulator.
		 */
		compatible = "pwm-regulator";
		regulator-name = "VDDGPU";
		regulator-min-microvolt = <700000>;
		regulator-max-microvolt = <922000>;
		pwm-supply = <&dc_in>;
		pwms = <&pwm_ao_ef 0 1500 0>;
		pwm-dutycycle-range = <100 0>;
		regulator-boot-on;
		regulator-always-on;
	};

	vdd_npu: regulator-vddnpu {
		/*
		 * SY8003ADFC Regulator.
		 */
		compatible = "pwm-regulator";
		regulator-name = "VDDNPU";
		regulator-min-microvolt = <733000>;
		regulator-max-microvolt = <933000>;
		pwm-supply = <&dc_in>;
		pwms = <&pwm_ao_ef 1 1500 0>;
		pwm-dutycycle-range = <100 0>;
		regulator-boot-on;
		regulator-always-on;
	};

	vddao_1v8: regulator-vddao-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "VDDAO_1V8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vddao_3v3>;
		regulator-always-on;
	};

	vddao_3v3: regulator-vddao-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VDDAO_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&dc_in>;
		regulator-always-on;
	};

	vddcpu_a: regulator-vddcpu-a {
		/*
		 * MP8756GD Regulator.
		 */
		compatible = "pwm-regulator";
		regulator-name = "VDDCPU_A";
		regulator-min-microvolt = <689000>;
		regulator-max-microvolt = <1049000>;
		pwm-supply = <&dc_in>;
		pwms = <&pwm_ao_cd 1 1500 0>;
		pwm-dutycycle-range = <100 0>;
		regulator-boot-on;
		regulator-always-on;
	};

	vddcpu_b: regulator-vddcpu-b {
		/*
		 * MP8756GD Regulator.
		 */
		compatible = "pwm-regulator";
		regulator-name = "VDDCPU_B";
		regulator-min-microvolt = <689000>;
		regulator-max-microvolt = <1049000>;
		pwm-supply = <&dc_in>;
		pwms = <&pwm_ao_ab 1 1500 0>;
		pwm-dutycycle-range = <100 0>;
		regulator-boot-on;
		regulator-always-on;
	};

	vddio_1v8: regulator-vddio-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "VDDIO_1V8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vddio_3v3>;
		regulator-always-on;
	};

	vddio_3v3: regulator-vddio-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VDDIO_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vddao_3v3>;
		regulator-always-on;
	};

	xtal: xtal-clk {
		compatible = "fixed-clock";
		clock-frequency = <24000000>;
		clock-output-names = "xtal";
		#clock-cells = <0>;
	};

	vddcpua: regulator-vddcpu-a {
		compatible = "pwm-regulator";
		regulator-name = "VDDCPU_A";
		regulator-min-microvolt = <689000>;
		regulator-max-microvolt = <1049000>;
		/* the filtered PWM output needs time to settle */
		regulator-ramp-delay = <150>;
		pwms = <&pwm_ao_cd 1 1500 0>;
		voltage-table = <1049000 0>,
				<1039000 3>,
				<1029000 6>,
				<1019000 9>,
				<1009000 12>,
				<999000 14>,
				<989000 17>,
				<979000 20>,
				<969000 23>,
				<959000 26>,
				<949000 29>,
				<939000 31>,
				<929000 34>,
				<919000 37>,
				<909000 40>,
				<899000 43>,
				<889000 45>,
				<879000 48>,
				<869000 51>,
				<859000 54>,
				<849000 56>,
				<839000 59>,
				<829000 62>,
				<819000 65>,
				<809000 68>,
				<799000 70>,
				<789000 73>,
				<779000 76>,
				<769000 79>,
				<759000 81>,
				<749000 84>,
				<739000 87>,
				<729000 89>,
				<719000 92>,
				<709000 95>,
				<699000 98>,
				<689000 100>;
		regulator-boot-on;
		regulator-always-on;
	};

	vddcpub: regulator-vddcpu-b {
		compatible = "pwm-regulator";
		regulator-name = "VDDCPU_B";
		regulator-min-microvolt = <689000>;
		regulator-max-microvolt = <1049000>;
		/* the filtered PWM output needs time to settle */
		regulator-ramp-delay = <150>;
		pwms = <&pwm_ao_ab 1 1500 0>;
		voltage-table = <1049000 0>,
				<1039000 3>,
				<1029000 6>,
				<1019000 9>,
				<1009000 12>,
				<999000 14>,
				<989000 17>,
				<979000 20>,
				<969000 23>,
				<959000 26>,
				<949000 29>,
				<939000 31>,
				<929000 34>,
				<919000 37>,
				<909000 40>,
				<899000 43>,
				<889000 45>,
				<879000 48>,
				<869000 51>,
				<859000 54>,
				<849000 56>,
				<839000 59>,
				<829000 62>,
				<819000 65>,
				<809000 68>,
				<799000 70>,
				<789000 73>,
				<779000 76>,
				<769000 79>,
				<759000 81>,
				<749000 84>,
				<739000 87>,
				<729000 89>,
				<719000 92>,
				<709000 95>,
				<699000 98>,
				<689000 100>;
		regulator-boot-on;
		regulator-always-on;
	};


	sound {
		compatible = "amlogic,axg-sound-card";
		model = "AOC-65T33Z";
		audio-aux-devs = <&tdmout_a>, <&tdmout_b>, <&tdmout_c>;
		audio-routing = "TDMOUT_A IN 0", "FRDDR_A OUT 0",
				"TDMOUT_A IN 1", "FRDDR_B OUT 0",
				"TDMOUT_A IN 2", "FRDDR_C OUT 0",
				"TDM_A Playback", "TDMOUT_A OUT",
				"TDMOUT_B IN 0", "FRDDR_A OUT 1",
				"TDMOUT_B IN 1", "FRDDR_B OUT 1",
				"TDMOUT_B IN 2", "FRDDR_C OUT 1",
				"TDM_B Playback", "TDMOUT_B OUT",
				"TDMOUT_C IN 0", "FRDDR_A OUT 2",
				"TDMOUT_C IN 1", "FRDDR_B OUT 2",
				"TDMOUT_C IN 2", "FRDDR_C OUT 2",
				"TDM_C Playback", "TDMOUT_C OUT",
				"SPDIFOUT_A IN 0", "FRDDR_A OUT 3",
				"SPDIFOUT_A IN 1", "FRDDR_B OUT 3",
				"SPDIFOUT_A IN 2", "FRDDR_C OUT 3",
				"SPDIFOUT_B IN 0", "FRDDR_A OUT 4",
				"SPDIFOUT_B IN 1", "FRDDR_B OUT 4",
				"SPDIFOUT_B IN 2", "FRDDR_C OUT 4";
		clocks = <&hifi CLKID_HIFI_PLL>,
			 <&mpll CLKID_MPLL0>,
			 <&mpll CLKID_MPLL1>;
		assigned-clocks = <&hifi CLKID_HIFI_PLL>,
				  <&mpll CLKID_MPLL0>,
				  <&mpll CLKID_MPLL1>;
		assigned-clock-rates = <1179648000>,
				       <270950400>,
				       <338688000>;

		dai-link-0 {
			sound-dai = <&frddr_a>;
		};

		dai-link-1 {
			sound-dai = <&frddr_b>;
		};

		dai-link-2 {
			sound-dai = <&frddr_c>;
		};

		/* 8ch HDMI interface */
		dai-link-3 {
			sound-dai = <&tdmif_a>;
			dai-format = "i2s";
			dai-tdm-slot-tx-mask-0 = <1 1>;
			dai-tdm-slot-tx-mask-1 = <1 1>;
			dai-tdm-slot-tx-mask-2 = <1 1>;
			dai-tdm-slot-tx-mask-3 = <1 1>;
			mclk-fs = <256>;

			codec {
				sound-dai = <&tohdmitx TOHDMITX_I2S_IN_A>;
			};
		};

		dai-link-4 {
			sound-dai = <&tdmif_b>;
			dai-format = "i2s";
			dai-tdm-slot-tx-mask-0 = <1 1>;
			mclk-fs = <256>;

			codec {
				sound-dai = <&tohdmitx TOHDMITX_I2S_IN_B>;
			};
		};

		dai-link-5 {
			sound-dai = <&tdmif_c>;
			dai-format = "i2s";
			dai-tdm-slot-tx-mask-0 = <1 1>;
			mclk-fs = <256>;

			codec {
				sound-dai = <&tohdmitx TOHDMITX_I2S_IN_C>;
			};
		};

		dai-link-6 {
			sound-dai = <&spdifout_a>;

			codec {
				sound-dai = <&tohdmitx TOHDMITX_SPDIF_IN_A>;
			};
		};

		dai-link-7 {
			sound-dai = <&spdifout_b>;

			codec {
				sound-dai = <&tohdmitx TOHDMITX_SPDIF_IN_B>;
			};
		};

		/* HDMI transmitter, fed from the TDM interfaces by tohdmitx */
		dai-link-8 {
			sound-dai = <&tohdmitx TOHDMITX_I2S_OUT>;

			codec {
				sound-dai = <&hdmi_tx>;
			};
		};
	};
};

&ext_mdio {
	external_phy: ethernet-phy@0 {
		reg = <0>;
		max-speed = <1000>;
		reset-assert-us = <20000>;
		reset-deassert-us = <50000>;
		reset-gpios = <&gpio GPIOH_7 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
	};
};

&ethmac {
	status = "okay";
	pinctrl-0 = <&eth_pins>, <&eth_rgmii_pins>;
	pinctrl-names = "default";
	phy-mode = "rgmii";
	phy-handle = <&external_phy>;
	rx-internal-delay-ps = <800>;
	amlogic,tx-delay-ns = <2>;
};

&cpu0 {
	cpu-supply = <&vddcpua>;
	operating-points-v2 = <&a73_opp_table>;
};

&cpu1 {
	cpu-supply = <&vddcpua>;
	operating-points-v2 = <&a73_opp_table>;
};

&cpu2 {
	cpu-supply = <&vddcpua>;
	operating-points-v2 = <&a73_opp_table>;
};

&cpu3 {
	cpu-supply = <&vddcpua>;
	operating-points-v2 = <&a73_opp_table>;
};

&cpu100 {
	cpu-supply = <&vddcpub>;
	operating-points-v2 = <&a53_opp_table>;
};

&cpu101 {
	cpu-supply = <&vddcpub>;
	operating-points-v2 = <&a53_opp_table>;
};

&cpu102 {
	cpu-supply = <&vddcpub>;
	operating-points-v2 = <&a53_opp_table>;
};

&cpu103 {
	cpu-supply = <&vddcpub>;
	operating-points-v2 = <&a53_opp_table>;
};

&pwm_ao_ab {
	status = "okay";
	pinctrl-0 = <&pwm_ao_a_pins>, <&pwm_ao_b_pins>;
	pinctrl-names = "default";
};

&pwm_ao_cd {
	status = "okay";
	pinctrl-0 = <&pwm_ao_d_pins>;
	pinctrl-names = "default";
};

&pwm_ao_ef {
	status = "okay";
	pinctrl-0 = <&pwm_ao_e_pins>, <&pwm_ao_f_pins>;
	pinctrl-names = "default";
};

&pwm_ao_gh {
	status = "okay";
	pinctrl-0 = <&pwm_ao_g_e_pins>;
	pinctrl-names = "default";
};

&pwm_ao_ab {
	status = "okay";
};

/* eMMC */
&sd_emmc_c {
	status = "okay";
	pinctrl-0 = <&emmc_ctrl_pins>, <&emmc_data_8b_pins>, <&emmc_ds_pins>;
	pinctrl-1 = <&emmc_clk_gate_pins>;
	pinctrl-names = "default", "clk-gate";

	bus-width = <8>;
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	max-frequency = <200000000>;
	disable-wp;
	non-removable;
	no-sdio;
	no-sd;

	power-domains = <&pwrc PWRC_T7_EMMC_ID>;

	vmmc-supply = <&vddio_3v3>;
	vqmmc-supply = <&vddio_1v8>;
};

&uart_a {
	status = "okay";
	clocks = <&xtal>, <&clkc_periphs CLKID_SYS_UART_A>, <&xtal>;
	clock-names = "xtal", "pclk", "baud";
};

&usb_comb {
	status = "okay";
	dr_mode = "host";
};

&usb2_phy0 {
	phy-supply = <&usb_5v0>;
};

&usb2_phy1 {
	phy-supply = <&usb_5v1>;
};

&usb3_phy {
	phy-supply = <&vddao_1v8>;
};

&gpu {
	status = "okay";
};

/ {
	hdmi-connector {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi_connector_in: endpoint {
				remote-endpoint = <&hdmi_tx_tmds_out>;
			};
		};
	};
};

&hdmi_tx {
	status = "okay";
};

&hdmi_tx_tmds_out {
	remote-endpoint = <&hdmi_connector_in>;
};

&vpu {
	status = "okay";
};

/ {
	usb_5v0: regulator-usb-5v0 {
		compatible = "regulator-fixed";
		regulator-name = "USB_5V0";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&dc_in>;
		gpio = <&gpio GPIOT_23 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	usb_5v1: regulator-usb-5v1 {
		compatible = "regulator-fixed";
		regulator-name = "USB_5V1";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&dc_in>;
		gpio = <&gpio GPIOY_16 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/* USB5744 hub supplies share pins with the unused SD interface. */
	regulator-usbhub-vdd {
		compatible = "regulator-fixed";
		regulator-name = "USBHUB_VDD";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		gpio = <&gpio GPIOC_0 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	regulator-usbhub2-vdd {
		compatible = "regulator-fixed";
		regulator-name = "USBHUB2_VDD";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		gpio = <&gpio GPIOC_1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	regulator-phy-pwr {
		compatible = "regulator-fixed";
		regulator-name = "PHY_PWR";
		gpio = <&gpio GPIOD_9 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};
};
